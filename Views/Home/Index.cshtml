@model List<ECommerceClothing.Models.Product>
@{
    ViewData["Title"] = "Home";
}
<link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />

<div class="container-fluid p-0 mb-5">
    <div class="home-hero">
        <h1>Welcome to our shop</h1>
        <p>Fashion for everyone</p>
        <a href="#product-list" class="btn hero-btn mt-3">Shop Now</a>
    </div>
</div>

<section class="marquee-section">
    <div class="marquee">
        <div class="marquee-track"><span>NEW COLLECTION</span><span>NEW COLLECTION</span><span>NEW COLLECTION</span></div>
        <div class="marquee-track"><span>NEW COLLECTION</span><span>NEW COLLECTION</span><span>NEW COLLECTION</span></div>
    </div>
</section>

<div class="product-section" id="product-list">
    <div class="container">

        @* 👉 ĐÂY LÀ THANH TOOLBAR SORT TÀNG HÌNH MỚI THÊM *@
        <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
            <div class="text-muted fw-bold small" style="letter-spacing: 1px;">
                [ <span id="item-count">@(Model?.Count ?? 0)</span> ITEMS ]
            </div>

            <div class="d-flex align-items-center">
                <label class="fw-bold small text-uppercase me-2" style="letter-spacing: 1px;">SORT BY:</label>
                <select id="sortSelect" class="form-select form-select-sm border-0 fw-bold bg-transparent shadow-none"
                        style="width: auto; cursor: pointer; letter-spacing: 1px;" onchange="sortProducts()">
                    <option value="default">FEATURED</option>
                    <option value="price_asc">PRICE: LOW TO HIGH</option>
                    <option value="price_desc">PRICE: HIGH TO LOW</option>
                </select>
            </div>
        </div>
        @* 👉 KẾT THÚC THANH TOOLBAR *@

        <div class="row g-4" id="all-products">

            @if (Model != null && Model.Count > 0)
            {
                foreach (var p in Model)
                {
                    var firstImage = p.Images?.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png";

                    // Thêm thuộc tính data-price vào đây để JS có cái mà sắp xếp
                    <div class="col-6 col-md-4 col-lg-3 product-item-js" data-price="@p.Price">
                        <div class="product-card">
                            <div class="product-image-container">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id">
                                    <img src="@firstImage" alt="@p.Name" class="product-img" />
                                </a>
                                <div class="product-actions-overlay">
                                    <button class="btn-hades btn-buy-now-trigger" data-id="@p.Id"
                                            @(User.IsInRole("Admin") ? "disabled style=cursor:not-allowed" : "")>
                                        BUY NOW
                                    </button>

                                    <div class="separator"></div>

                                    <button class="btn-hades btn-quick-view" data-id="@p.Id"
                                            @(User.IsInRole("Admin") ? "disabled style=cursor:not-allowed" : "")>
                                        ADD TO CART
                                    </button>
                                </div>
                            </div>
                            <div class="product-info">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" class="product-name">@p.Name</a>
                                <div class="product-price">@((p.Price * 1000).ToString("#,##0")) VND</div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center"><p>No products available.</p></div>
            }

        </div>

        <div id="pagination-controls" class="d-flex justify-content-center align-items-center mt-5 gap-3" style="font-family: sans-serif;">
        </div>

    </div>
</div>

<div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-0 border-0">
            <div id="quickViewContent" class="modal-body p-0">
            </div>
        </div>
    </div>
</div>

@* 👉 THÊM SCRIPT ĐỂ TỰ ĐỘNG SẮP XẾP SẢN PHẨM MÀ KHÔNG CẦN LOAD LẠI TRANG *@
@section Scripts {
    <script>
        function sortProducts() {
            var sortVal = document.getElementById("sortSelect").value;
            var container = document.getElementById("all-products");
            var products = Array.from(container.getElementsByClassName("product-item-js"));

            if (sortVal === "default") {
                // Khó để biết vị trí default (thường là ngày tạo), nên cách xịn nhất là reload lại trang bỏ biến sort
                window.location.href = window.location.pathname;
                return;
            }

            products.sort(function(a, b) {
                var priceA = parseFloat(a.getAttribute("data-price"));
                var priceB = parseFloat(b.getAttribute("data-price"));

                if (sortVal === "price_asc") {
                    return priceA - priceB;
                } else if (sortVal === "price_desc") {
                    return priceB - priceA;
                }
            });

            // Gỡ hết các sản phẩm hiện tại ra và đắp lại theo thứ tự mới
            container.innerHTML = "";
            products.forEach(function(item) {
                container.appendChild(item);
            });
        }
    </script>
}
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using ECommerceClothing.Models
@inject UserManager<AppUser> UserManager
@inject ECommerceClothing.Data.AppDbContext _context
@{
    var currentCat = Context.Request.Query["categoryId"].ToString();
    var menuCategories = _context.Categories.Include(c => c.ProductTypes).ToList();

    var activeVouchers = _context.Vouchers
        .Where(v => v.IsActive == true
                 && v.IsPublic == false
                 && v.EndDate >= DateTime.Now
                 && v.UsedCount < v.Quantity)
        .ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NIXONÉ</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/productdetail.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/minicart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    @RenderSection("Styles", required: false)

    <style>
        body {
            padding-bottom: 30px;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-md navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand logo-text" asp-controller="Home" asp-action="Index">
                NIXONÉ<span class="logo-dot">®</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(string.IsNullOrEmpty(currentCat) ? "active fw-bold text-dark" : "")"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-categoryId="">
                            Shop all
                        </a>
                    </li>

                    @foreach (var cat in menuCategories.Take(3))
                    {
                        <li class="nav-item hover-dropdown position-relative">
                            <a class="nav-link @(currentCat == cat.Id.ToString() ? "active fw-bold text-dark" : "")"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-categoryId="@cat.Id">
                                @cat.Name
                            </a>

                            @if (cat.ProductTypes != null && cat.ProductTypes.Any())
                            {
                                <ul class="dropdown-menu border-0 shadow-sm mt-0 position-absolute">
                                    @foreach (var type in cat.ProductTypes)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 text-muted"
                                               asp-controller="Product"
                                               asp-action="Index"
                                               asp-route-categoryId="@cat.Id"
                                               asp-route-typeId="@type.ProductTypeId">
                                                @type.Name
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }

                    @if (menuCategories.Count > 3)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle no-underline text-dark fw-bold d-flex align-items-center"
                               href="#" id="moreCategoriesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                               style="text-decoration: none !important;">
                                Collections <i class="fa-solid fa-chevron-down ms-1" style="font-size: 0.8rem;"></i>
                            </a>
                            <ul class="dropdown-menu border-0 shadow-sm" aria-labelledby="moreCategoriesDropdown">
                                @foreach (var cat in menuCategories.Skip(3))
                                {
                                    <li>
                                        <a class="dropdown-item @(currentCat == cat.Id.ToString() ? "fw-bold bg-light" : "")"
                                           asp-controller="Product"
                                           asp-action="Index"
                                           asp-route-categoryId="@cat.Id">
                                            @cat.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    
                </ul>

                <form asp-controller="Product" asp-action="Search" method="get" class="nav-search me-4">
                    <input type="text" name="query" placeholder="Search here..."
                           value="@Context.Request.Query["query"]"
                           pattern=".*\S+.*"
                           title="Please enter a valid keyword."
                           required />
                    <button type="submit"><i class="fa fa-search"></i></button>
                </form>

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                    <li class="nav-item me-3 mt-1">
                        <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
                            <i class="fa-solid fa-cart-shopping fs-5"></i>
                            <span id="cart-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  style="font-size: 0.65rem; padding: 0.35em 0.5em; border: 2px solid white;">
                                0
                            </span>
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        var user = await UserManager.GetUserAsync(User);
                        var displayName = user?.FullName ?? User.Identity.Name;
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-bold" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                Hi, @displayName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole("Admin") || User.Identity.Name == "admin@gmail.com")
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Profile" asp-action="Index">Profile</a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Logout</a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link fw-bold" asp-controller="Account" asp-action="Login">LOGIN</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    
    <main role="main">
        @RenderBody()
    </main>

    <div class="d-flex justify-content-center mt-5 mb-5">
        <ul class="pagination">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)" style="color: black;">&laquo; Previous</a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i"
                       style="@(i == ViewBag.CurrentPage ? "background-color: black; border-color: black; color: white;" : "color: black;")">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)" style="color: black;">Next &raquo;</a>
                </li>
            }
        </ul>
    </div>

    <footer class="footer-section text-white pt-5 pb-2">
        <div class="container">
            <div class="row border-bottom pb-4">
                 
                <div class="col-md-3 mb-4">
                    <h5 class="logo-text mb-3" style="color: white; font-size: 1.4rem;">
                        NIXONÉ<span class="logo-dot">®</span>
                    </h5>
                    <p class="footer-desc">
                        Elevate your street style with NIXONÉ. High-quality clothing designed for the modern urban soul.
                    </p>

                    <div class="mt-3">
                        <a href="#" class="footer-link d-block">
                            <i class="fa-brands fa-facebook-f me-2"></i> Nixone.vn
                        </a>
                        <a href="#" class="footer-link d-block">
                            <i class="fa-brands fa-instagram me-2"></i> Nixone.store.vn
                        </a>
                    </div>
                </div>
                 
                <div class="col-md-3 mb-4">
                    <h6 class="footer-title">Store Locations</h6>
                    <ul class="list-unstyled footer-text">
                        <li class="mb-2">
                            <i class="fa-solid fa-location-dot me-2"></i>
                            <strong>Hanoi:</strong> 123 Ba Dinh St, Ba Dinh Dist.
                        </li>
                        <li class="mb-2">
                            <i class="fa-solid fa-location-dot me-2"></i>
                            <strong>Saigon:</strong> 456 Le Loi St, Dist 1, HCMC.
                        </li>
                        <li>
                            <i class="fa-solid fa-location-dot me-2"></i>
                            <strong>Can Tho:</strong> 789 Ninh Kieu St, Ninh Kieu Dist.
                        </li>
                    </ul>
                </div>
                 
                <div class="col-md-3 mb-4">
                    <h6 class="footer-title">Customer Support</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="footer-link">Size Guide</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Shipping Policy</a></li>
                        <li class="mb-2"><a href="#" class="footer-link">Returns & Exchanges</a></li>
                        <li><a href="#" class="footer-link">Privacy Policy</a></li>
                    </ul>
                </div>

                <div class="col-md-2 mb-4">
                    <h6 class="footer-title">Contact Us</h6>

                    <ul class="list-unstyled footer-text">
                        <li class="mb-2 d-flex align-items-start">
                            <i class="fa-solid fa-envelope me-2 mt-1"></i>
                            <span class="email-text">cskh.nixoneoficial@gmail.com</span>
                        </li>
                        <li class="mb-2">
                            <i class="fa-solid fa-phone me-2"></i> 1900 1289
                        </li>
                        <li>
                            <i class="fa-solid fa-clock me-2"></i> Mon - Sun | 09:00 - 22:00
                        </li>
                    </ul>
                </div>

                
                <div class="col-md-3 mb-4">
                    <h6 class="footer-title">Payments</h6>

                    <div class="d-flex flex-column gap-3 mt-3">

                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-money-bill-wave"></i>
                            <span>Cash on Delivery</span>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <img src="~/images/momo_logo.jpg"
                                 style="height: 22px;">
                            <span>MoMo Wallet</span>
                        </div>

                    </div>
                </div>

            </div>

            <div class="row mt-3">
                <div class="col-12 text-center">
                    <p class="footer-copy">
                        © 2026 NIXONÉ Studio. All rights reserved.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    @if (activeVouchers.Any())
    {
        <div class="voucher-ticker-container">
            <div class="ticker-wrapper">

                @for (int block = 0; block < 2; block++)
                {
                    <div class="ticker-item">
                        @for (int i = 0; i < 15; i++)
                        {
                            @foreach (var v in activeVouchers)
                            {
                                <span>
                                    🔥 USE CODE: <span class="code">@v.Code</span> - @v.Title (UNTIL @v.EndDate.ToString("dd/MM"))
                                    &nbsp;&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;&nbsp;
                                </span>
                            }
                        }
                    </div>
                }

            </div>
        </div>
    }

    <div class="offcanvas offcanvas-end" tabindex="-1" id="cartSidebar" aria-labelledby="cartSidebarLabel">
        <div class="cart-header border-bottom p-3 d-flex justify-content-between align-items-center">
            <h5 class="cart-title mb-0 fw-bold text-uppercase" style="letter-spacing: 2px;">Cart</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="cart-body p-3" id="cartSidebarBody" style="overflow-y: auto; height: calc(100vh - 150px);">
        </div>
        <div class="cart-footer border-top p-3 bg-white" style="position: absolute; bottom: 0; width: 100%;">
            <div class="cart-total d-flex justify-content-between fw-bold mb-3">
                <span class="text-uppercase" style="letter-spacing: 1px;">TOTAL</span>
                <span id="cartSidebarTotal">0 VND</span>
            </div>
            <div class="cart-buttons d-flex gap-2">
                <a href="/Cart" class="btn btn-outline-dark w-50 rounded-0 fw-bold">VIEW CART</a>
                <a href="/Checkout?checkoutAll=true" class="btn btn-dark w-50 rounded-0 fw-bold">CHECKOUT</a>
            </div>
        </div>
    </div>

    <div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-0 border-0 shadow-lg">
                <div id="quickViewContent" class="modal-body p-0">
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="sizeGuideModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-5 pt-2 text-center" id="sizeGuideContent">
                </div>
            </div>
        </div>
    </div>
    
    <script>
        const isCurrentUserAdmin = @(User.Identity.IsAuthenticated && User.IsInRole("Admin") ? "true" : "false");
    </script> 
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
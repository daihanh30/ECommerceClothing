@model List<ECommerceClothing.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    var preTickedItems = ViewBag.PreTickedItems as List<string>;
}

<link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />

<div class="cart-container">
    <h2 class="cart-title">CART</h2>

    <div id="js-error-message" class="alert alert-danger text-center mt-2 mb-2" style="display:none; font-weight: bold;"></div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center mt-2 mb-2">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model != null && Model.Count > 0)
    {
        <form action="/Checkout" method="get" id="cart-form">
            <div id="cart-list">
                @foreach (var item in Model)
                {
                    <div class="cart-item js-cart-item" data-price="@item.Product.Price" data-id="@item.ProductId" data-size="@item.Size">

                        <div class="item-select">
                            @{
                                string identifier = $"{item.ProductId}|{item.Size}";
                                bool isChecked = true; 
                                 
                                if (preTickedItems != null)
                                {
                                    isChecked = preTickedItems.Contains(identifier);
                                }
                            }
                            <input type="checkbox" name="selectedItems" value="@item.ProductId|@item.Size|@item.Quantity" class="cart-checkbox js-checkbox" onchange="updateTotal()" @(isChecked ? "checked" : "") />
                        </div>

                        <div class="item-img-box">
                            <img src="@(item.Product.Images?.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png")"
                                 alt="@item.Product.Name">
                        </div>

                        <div class="item-info">
                            <p class="brand">NIXONÉ</p>
                            <p class="name">@item.Product.Name</p>
                            <p class="size">Size: @item.Size</p>
                        </div>

                        <div class="item-price-display">
                            @((item.Product.Price * 1000).ToString("#,##0")) VND
                        </div>

                        <div class="quantity">
                            <button type="button" onclick="changeQtyLarge(this, -1)">-</button>
                            <input type="text" value="@item.Quantity" class="qty-input js-qty-input" readonly />
                            <button type="button" onclick="changeQtyLarge(this, 1)">+</button>
                        </div>
                    </div>
                }
            </div>

            <div class="cart-total-section">
                <div class="cart-total">
                    <span>TOTAL</span>
                    <span id="display-total-price">0 VND</span>
                </div>

                <div class="cart-action-center">
                    <button type="submit" class="checkout-btn">CHECKOUT</button>
                    <button type="button" class="continue-btn" onclick="window.location.href='/'">CONTINUE SHOPPING</button>
                </div>
            </div>
        </form>
    }
    else
    {
        <div class="empty-cart">
            <p>Your cart is empty.</p>
            <a href="/" class="continue-btn">GO TO SHOP</a>
        </div>
    }
</div>

<script>
    //Hàm tính tổng tiền
    function updateTotal() {
        let total = 0;
        const rows = document.querySelectorAll('.js-cart-item');

        rows.forEach(row => {
            const checkbox = row.querySelector('.js-checkbox');
            if (checkbox && checkbox.checked) {
                let priceStr = row.getAttribute('data-price');
                if(priceStr) priceStr = priceStr.replace(',', '.');

                const price = parseFloat(priceStr) || 0;
                const qtyInput = row.querySelector('.js-qty-input');
                const qty = qtyInput ? parseInt(qtyInput.value) : 1;

                total += price * qty;
            }
        });

        const formattedTotal = (total * 1000).toLocaleString('en-US');
        const displayPriceEl = document.getElementById('display-total-price');
        if(displayPriceEl) {
            displayPriceEl.innerText = formattedTotal + " VND";
        }
    }

    //Hàm thay đổi số lượng
    function changeQtyLarge(btn, change) {
        const row = btn.closest('.js-cart-item');
        const input = row.querySelector('.js-qty-input');
        const id = row.getAttribute('data-id');
        const size = row.getAttribute('data-size');

        let currentQty = parseInt(input.value);
        let newQty = currentQty + change;

        if (newQty < 1) {
            fetch(`/Cart/Remove?id=${id}&size=${size}`, { method: 'POST' })
                .then(() => {
                    row.remove();
                    updateTotal();
                    if (document.querySelectorAll('.js-cart-item').length === 0) {
                        window.location.reload();
                    }
                });
            return;
        }

        input.value = newQty;
        updateTotal();
         
        const checkbox = row.querySelector('.js-checkbox');
        if (checkbox) {
            checkbox.value = id + '|' + size + '|' + newQty;
        }

        fetch(`/Cart/UpdateQuantity?id=${id}&size=${size}&change=${change}`, { method: 'POST' });
    }

    //Khởi chạy khi trang load xong
    document.addEventListener("DOMContentLoaded", function() {
        updateTotal();

        const cartForm = document.getElementById('cart-form');
        if (cartForm) {
            cartForm.addEventListener('submit', function(event) {
                const checkedItems = document.querySelectorAll('.js-checkbox:checked');
                const errorBox = document.getElementById('js-error-message');

                if (checkedItems.length === 0) {
                    event.preventDefault(); 
                    errorBox.innerText = "Please select at least one product to proceed!";
                    errorBox.style.display = 'block';
                     
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else { 
                    errorBox.style.display = 'none';
                }
            });
        }
    });
</script>
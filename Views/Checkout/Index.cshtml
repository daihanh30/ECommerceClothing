    @model ECommerceClothing.Models.CheckoutViewModel
    @{
        ViewData["Title"] = "Checkout";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <link rel="stylesheet" href="~/css/checkout.css?v=1" />
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>

    <div class="container py-5">
        <form asp-action="PlaceOrder" method="post" id="checkoutForm">
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="checkout-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="section-title mb-0">Shipping Information</h5>
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-circle d-flex align-items-center justify-content-center"
                                    style="width: 32px; height: 32px;"
                                    data-bs-toggle="modal" data-bs-target="#addressListModal"
                                    onclick="loadAddressList()">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>

                        <div class="mb-3">
                            <input type="text" class="form-control" placeholder="Full Name" asp-for="FullName" id="FullName" required>
                        </div>

                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <input type="email" id="Email" name="Email" class="form-control"
                                       value="@User.Identity.Name" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <input type="text" class="form-control" placeholder="Phone Number" asp-for="PhoneNumber" id="PhoneNumber"
                                       required
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                            </div>
                        </div>

                        <div class="mb-3 position-relative">
                            <input type="text" class="form-control pe-5" placeholder="Address (House number, street...)" asp-for="Address" id="Address" required>
                            <div id="addressSpinner" class="spinner-border spinner-border-sm text-secondary position-absolute d-none"
                                 style="top: 15px; right: 15px;" role="status">
                            </div>
                            <small id="mapErrorMsg" class="text-danger d-none mt-1 fw-bold">
                                <i class="fa-solid fa-circle-exclamation me-1"></i> Address not found on the map. Please type a clearer address or drag the pin manually!
                            </small>
                        </div>

                        <input type="hidden" id="inputLat" name="Latitude">
                        <input type="hidden" id="inputLng" name="Longitude">
                        <input type="hidden" id="inputDistance" name="Distance">
                        <input type="hidden" id="inputDiscount" name="DiscountAmount" value="0">
                        <input type="hidden" id="inputVoucherCode" name="VoucherCode" value="">
                        <input type="hidden" id="inputShippingFee" name="ShippingFee" value="0">

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase text-muted">
                                Delivery Location (Drag the red pin to select)
                            </label>

                            <div id="miniMap" style="width: 100%; height: 300px; border-radius: 8px; border: 2px dashed #ccc;"></div>

                            <div class="mt-2 d-flex justify-content-between align-items-center">
                                <div class="small text-muted">
                                    Distance from shop: <span id="distanceDisplay" class="fw-bold text-dark">0 km</span>
                                </div>

                                <div class="text-end">
                                    <button id="btnLocation" type="button" onclick="getCurrentLocation()"
                                            class="btn btn-sm btn-outline-dark">
                                        📍 Use my location
                                    </button>
                                </div>
                            </div>
                            <div id="locationError" class="text-danger small mt-2 text-end" style="display: none;"></div>
                        </div>

                        <div class="mb-3">
                            <textarea class="form-control" rows="2" placeholder="Additional notes (e.g., Deliver during office hours)" asp-for="Note"></textarea>
                        </div>
                    </div>

                    <div class="checkout-card mt-4">
                        <h5 class="section-title">Payment Method</h5>

                        <div class="mb-2">
                            <input type="radio" id="cod" name="PaymentMethod" value="COD" class="payment-method-input d-none" checked>
                            <label for="cod" class="payment-method-label w-100">
                                <div class="payment-method-item">
                                    <img src="https://cdn-icons-png.flaticon.com/512/2331/2331941.png" class="payment-icon" alt="COD">
                                    <span>Cash on delivery (COD)</span>
                                </div>
                            </label>
                        </div>

                        <div>
                            <input type="radio" id="momo" name="PaymentMethod" value="MoMo" class="payment-method-input d-none">
                            <label for="momo" class="payment-method-label w-100">
                                <div class="payment-method-item">
                                    <img src="/images/momo_logo.jpg" class="payment-icon" alt="MoMo">
                                    <span>Pay via MoMo Wallet</span>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="checkout-card">
                        <h5 class="section-title">Cart (@Model.CartItems.Count items)</h5>
                        <div class="cart-list mb-4">
                            @foreach (var item in Model.CartItems)
                            {
                                <div class="cart-summary-item">
                                    <img src="@item.ProductImage" class="summary-img" alt="@item.ProductName">
                                    <div class="summary-info flex-grow-1">
                                        <h6>@item.ProductName</h6>
                                        <span class="size-badge">@item.Size</span>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold small">@((item.Price * 1000).ToString("#,##0")) VND</div>
                                        <div class="text-muted small">x @item.Quantity</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <hr class="my-4 text-muted opacity-50">

                        <div class="mb-4">
                            <h6 class="fw-bold mb-3">Promo Code</h6>
                            <div class="voucher-select-box d-flex justify-content-between align-items-center mb-2"
                                 data-bs-toggle="modal" data-bs-target="#voucherModal">
                                <div class="d-flex align-items-center text-muted">
                                    <i class="fa-solid fa-ticket me-2"></i>
                                    <span id="voucherSelectorText">Select voucher</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span id="discountBadge" class="badge bg-info text-white me-2 d-none"></span>
                                    <i class="fa-solid fa-chevron-right small"></i>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <div class="input-group h-45 flex-grow-1">
                                    <input type="text" class="form-control input-voucher-manual" id="manualInput" placeholder="Enter code">
                                    <button class="btn btn-black-apply" type="button">Apply</button>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-50">

                        <div>
                            <h6 class="fw-bold mb-3">Order Summary</h6>

                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Subtotal</span>
                                <span class="fw-bold" id="subTotalDisplay" data-price="@((Model.TotalAmount * 1000).ToString("0"))">
                                    @((Model.TotalAmount * 1000).ToString("#,##0")) VND
                                </span>
                            </div>

                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Shipping Fee</span>
                                <span id="shippingFeeDisplay">-</span>
                            </div>

                            <div class="d-flex justify-content-between mb-2 d-none" id="discountRow">
                                <span class="text-success">Discount</span>
                                <span id="discountDisplay" class="text-success">-0 VND</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="fw-bold text-dark">Total</span>
                                <h4 id="finalTotalDisplay" class="fw-bold text-dark m-0">
                                    @((Model.TotalAmount * 1000).ToString("#,##0")) VND
                                </h4>
                            </div>
                        </div>

                        <button type="submit" class="btn-place-order mt-4 w-100">PLACE ORDER</button>
                    </div>
                </div>
            </div>
        </form>


    @*Modal Voucher *@
        <div class="modal fade" id="voucherModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 rounded-4">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold">Select Voucher</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body bg-light mt-3 p-3">
                        <div id="voucherListContainer">
                            <div class="text-center text-muted p-3">No suitable vouchers found.</div>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0 bg-light">
                        <button type="button" class="btn btn-dark w-100 py-2 rounded-3 fw-bold"
                                data-bs-dismiss="modal" onclick="confirmVoucherSelection()">
                            APPLY NOW
                        </button>
                    </div>
                </div>
            </div>
        </div>


    @*Modal Danh sách địa chỉ *@
        <div class="modal fade" id="addressListModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold">My Addresses</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body bg-light mt-3 p-3" style="max-height: 400px; overflow-y: auto;">
                        <div id="addressListContainer" class="d-flex flex-column gap-2">
                            <div class="text-center text-muted">Loading...</div>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0 bg-light justify-content-between">
                        <button type="button" class="btn btn-outline-dark fw-bold" onclick="openAddNewAddressModal()">
                            + Add New
                        </button>
                        <button type="button" class="btn btn-dark fw-bold" onclick="confirmSelectAddress()">Confirm</button>
                    </div>
                </div>
            </div>
        </div>

    @* Modal Thêm địa chỉ mới *@
        <div class="modal fade" id="addAddressModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 rounded-4">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold">Add New Address</h5>
                        <button type="button" class="btn-close" aria-label="Close" onclick="backToAddressList()"></button>
                    </div>
                    <div class="modal-body">
                        <form id="newAddressForm">
                            <input type="text" id="newFullName" class="form-control mb-3" placeholder="Full Name"
                                   required oninput="this.value = this.value.replace(/[0-9]/g, '')">

                            <input type="text" id="newPhone" class="form-control mb-3" placeholder="Phone Number"
                                   required minlength="10" maxlength="11" oninput="this.value = this.value.replace(/[^0-9]/g, '')">

                            <div class="row">
                                <div class="col-12 mb-3">
                                    <select id="newProvince" class="form-select">
                                        <option value="" selected disabled>Select Province/City</option>
                                    </select>
                                </div>
                                <div class="col-12 mb-3">
                                    <select id="newDistrict" class="form-select" disabled>
                                        <option value="" selected disabled>Select District</option>
                                    </select>
                                </div>
                                <div class="col-12 mb-3">
                                    <select id="newWard" class="form-select" disabled>
                                        <option value="" selected disabled>Select Ward</option>
                                    </select>
                                </div>

                                <div class="col-12 mb-3">
                                    <input type="text" id="newAddressDetail" class="form-control" placeholder="Specific Address (House number, street...)">
                                    <small id="addressErrorMsg" class="text-danger d-none mt-1 fw-bold">
                                        <i class="fa-solid fa-circle-exclamation me-1"></i> Please enter and select the full address!
                                    </small>
                                </div>
                            </div>

                            <div class="form-check form-switch p-0 d-flex align-items-center justify-content-between border rounded p-3 bg-light">
                                <label class="form-check-label mb-0 ms-2 fw-bold text-muted" for="newIsDefault">Set as default address</label>
                                <input class="form-check-input m-0" type="checkbox" role="switch" id="newIsDefault" style="width: 40px; height: 20px;">
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-light" onclick="backToAddressList()">
                            Back
                        </button>
                        <button type="button" class="btn btn-dark px-4 fw-bold" onclick="saveNewAddress()">Save Address</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="voucherErrorModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content border-0 shadow">
                    <div class="modal-body text-center p-4">
                        <div class="mb-3 text-danger">
                            <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" class="bi bi-exclamation-circle" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                                <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z" />
                            </svg>
                        </div>
                        <h5 class="fw-bold mb-3">Error</h5>
                        <p id="voucherErrorMsg" class="text-muted mb-4"></p>
                        <button type="button" class="btn btn-dark px-4 rounded-pill fw-bold w-100" data-bs-dismiss="modal">OK</button>
                    </div>
                </div>
            </div>
        </div>

    @section Scripts {

            <script>
                // dữ liệu toàn cục
                let liveVouchers = [];
                let globalShippingFee = 0;
                let globalDiscount = 0;
                let tempSelectedVoucher = null;
                let provincesData = [];
                let map, marker;

                let typingTimer;
                const doneTypingInterval = 800;
                //token
                mapboxgl.accessToken = '@(ViewBag.ShopLocation?.MapboxToken)';
                    const shopLat = parseFloat('@(ViewBag.ShopLocation?.Latitude ?? 10.7769)');
                    const shopLong = parseFloat('@(ViewBag.ShopLocation?.Longitude ?? 106.7009)');

                    const SHOP_LOCATION = [shopLong, shopLat];

                function showMapLoader() {
                    const loader = document.getElementById('addressSpinner');
                    if (loader) loader.classList.remove('d-none');
                }
                function hideMapLoader() {
                    const loader = document.getElementById('addressSpinner');
                    if (loader) loader.classList.add('d-none');
                }

                function movePinToAddress(addressText) {
                    if (!map || !addressText) return;

                    showMapLoader();
                    const errorLabel = document.getElementById('mapErrorMsg');
                    if(errorLabel) errorLabel.classList.add('d-none');

                    let cleanQuery = addressText.replace(/Xã |Phường |Thị trấn |Huyện |Quận |Thị xã |Tỉnh |Thành phố /gi, "");
                    //gửi request đi gọi map
                    const url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(cleanQuery)}.json?access_token=${mapboxgl.accessToken}&country=vn`;

                    fetch(url)
                        .then(res => res.json())
                        .then(data => {
                            if (data.features && data.features.length > 0) {
                                const [lng, lat] = data.features[0].center;

                                map.flyTo({ center: [lng, lat], zoom: 15 });
                                marker.setLngLat([lng, lat]);
                                calculateShipping(lat, lng);

                                map.once('idle', () => {
                                    hideMapLoader();
                                });
                            } else {
                                hideMapLoader();
                                if(errorLabel) errorLabel.classList.remove('d-none');
                            }
                        })
                        .catch(err => {
                            console.error("Error Geocoding:", err);
                            hideMapLoader();
                            if(errorLabel) errorLabel.classList.remove('d-none');
                        });
                }
                //tính toán phí ship dựa trên khoảng cách từ map
                function calculateShipping(lat, lng) {
                    document.getElementById('inputLat').value = lat;
                    document.getElementById('inputLng').value = lng;

                    const R = 6371;
                    const dLat = (shopLat - lat) * Math.PI / 180;
                    const dLon = (shopLong - lng) * Math.PI / 180;
                    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                      Math.cos(lat * Math.PI / 180) * Math.cos(shopLat * Math.PI / 180) * Math.sin(dLon/2) * Math.sin(dLon/2);
                    const km = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));

                    document.getElementById('distanceDisplay').innerText = km.toFixed(1) + " km";
                    document.getElementById('inputDistance').value = km.toFixed(1);

                    let fee = 0;
                    if (km > 50) fee = 30000;
                    else {
                        let calc = Math.round(km * 3000);
                        fee = (calc > 20000 || km > 30) ? 20000 : calc;
                        if (fee < 10000) fee = 10000;
                    }

                    globalShippingFee = fee;
                    document.getElementById('inputShippingFee').value = fee;
                    document.getElementById('shippingFeeDisplay').innerText = fee.toLocaleString('vi-VN') + " VND";

                    recalculateTotal();
                }

                function getCurrentLocation() {
                    const btn = document.getElementById("btnLocation");
                    const errorDiv = document.getElementById("locationError")
                    if (errorDiv) errorDiv.innerText = "";
                        if (!navigator.geolocation) {
                        if (errorDiv) errorDiv.innerText = "Geolocation not supported";
                        return;
                    }

                    btn.innerText = "⏳ Getting location...";
                    btn.disabled = true;

                       navigator.geolocation.getCurrentPosition(
                        async (position) => {
                            const lat = position.coords.latitude;
                            const lng = position.coords.longitude;

                            map.flyTo({ center: [lng, lat], zoom: 16 });
                            marker.setLngLat([lng, lat]);
                            calculateShipping(lat, lng);
                            //gọi api mapbox, gửi tọa độ, map trả về địa chỉ
                            const url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${lng},${lat}.json?access_token=${mapboxgl.accessToken}`;
                            const res = await fetch(url);
                            const data = await res.json();

                            if (data.features && data.features.length > 0) {
                                const address = data.features[0].place_name;
                                if (document.getElementById("Address")) {
                                    document.getElementById("Address").value = address;
                                }
                            }

                            btn.innerText = "Use my location";
                            btn.disabled = false;
                         },
                            (error) => {
                                if (errorDiv) errorDiv.innerText = "Cannot get location";
                                console.log(error);
                                btn.innerText = "Use my location";
                                btn.disabled = false;
                            }
                        );
                    }

                document.addEventListener("DOMContentLoaded", function() {
                    if (document.getElementById('miniMap')) {
                        map = new mapboxgl.Map({
                            container: 'miniMap',
                            style: 'mapbox://styles/mapbox/satellite-streets-v12',
                            center: SHOP_LOCATION,
                            zoom: 13
                        });

                        marker = new mapboxgl.Marker({ draggable: true })
                            .setLngLat(SHOP_LOCATION)
                            .addTo(map);

                        marker.on('dragend', () => {
                            const lngLat = marker.getLngLat();
                            calculateShipping(lngLat.lat, lngLat.lng);
                        });
                    }

                    // bắt sk ở ô địa chỉ 
                    const mainAddressInput = document.getElementById('Address');
                    if (mainAddressInput) {
                        mainAddressInput.addEventListener('input', function () {
                            clearTimeout(typingTimer);
                            const addressText = this.value.trim();

                            const errorLabel = document.getElementById('mapErrorMsg');
                            if(errorLabel) errorLabel.classList.add('d-none');

                            if (addressText.length > 5) {
                                typingTimer = setTimeout(() => {
                                    movePinToAddress(addressText);
                                }, doneTypingInterval);
                            }
                        });

                        mainAddressInput.addEventListener('keypress', function (e) {
                            if (e.key === 'Enter') {
                                e.preventDefault();
                                clearTimeout(typingTimer);
                                movePinToAddress(this.value.trim());
                            }
                        });
                    }

                     // load địa chỉ được cài mặc định
                    fetch('/Address/GetDefaultAddress')
                        .then(res => res.json())
                        .then(res => {
                            if (res.success && res.data) {
                                fillMainForm(res.data);
                            }
                        })
                        .catch(err => console.log("No default address found"));

                    // api tỉnh thành vn
                    fetch('https://provinces.open-api.vn/api/?depth=3')
                        .then(res => res.json())
                        .then(data => {
                            provincesData = data;
                            const provinceSelect = document.getElementById('newProvince');
                            data.forEach(p => {
                                provinceSelect.options.add(new Option(p.name, p.code));
                            });
                        });

                    document.getElementById('newProvince').addEventListener('change', function() {
                        const provinceCode = this.value;
                        const districtSelect = document.getElementById('newDistrict');
                        const wardSelect = document.getElementById('newWard');

                        districtSelect.innerHTML = '<option value="" selected disabled>Select District</option>';
                        wardSelect.innerHTML = '<option value="" selected disabled>Select Ward</option>';
                        wardSelect.disabled = true;

                        if (provinceCode) {
                            const province = provincesData.find(p => p.code == provinceCode);
                            province.districts.forEach(d => {
                                districtSelect.options.add(new Option(d.name, d.code));
                            });
                            districtSelect.disabled = false;
                        }
                    });

                    document.getElementById('newDistrict').addEventListener('change', function() {
                        const provinceCode = document.getElementById('newProvince').value;
                        const districtCode = this.value;
                        const wardSelect = document.getElementById('newWard');

                        wardSelect.innerHTML = '<option value="" selected disabled>Select Ward</option>';

                        if (districtCode) {
                            const province = provincesData.find(p => p.code == provinceCode);
                            const district = province.districts.find(d => d.code == districtCode);
                            district.wards.forEach(w => {
                                wardSelect.options.add(new Option(w.name, w.code));
                            });
                            wardSelect.disabled = false;
                        }
                    });

                });
                //VOUCHER
             // gọi api voucher
                fetch('/Checkout/GetAvailableVouchers')
                    .then(res => res.json())
                    .then(res => {
                        if (res.success) {
                            liveVouchers = res.data;
                            renderVoucherList();
                        }
                    })
                    .catch(err => console.log("Error loading vouchers:", err));

                const btnApply = document.querySelector('.btn-black-apply');
                if(btnApply) {
                    btnApply.addEventListener('click', applyManualCode);
                }

                function renderVoucherList() {
                const container = document.getElementById('voucherListContainer');
                if (!container) return;

                if (liveVouchers.length === 0) {
                    container.innerHTML = '<div class="text-center text-muted p-3">No available vouchers at the moment.</div>';
                    return;
                }

                const subTotal = parseFloat(document.getElementById('subTotalDisplay').getAttribute('data-price')) || 0;

                let sortedVouchers = [...liveVouchers].sort((a, b) => {
                    let aDisabled = a.isLimitReached || subTotal < a.min_order;
                    let bDisabled = b.isLimitReached || subTotal < b.min_order;
                    return (aDisabled === bDisabled) ? 0 : aDisabled ? 1 : -1;
                });

                let html = '';
                sortedVouchers.forEach(v => {
                    let notEnoughTotal = subTotal < v.min_order;
                    let isDisabled = v.isLimitReached || notEnoughTotal;

                    let badgeHtml = '';
                    if (v.isLimitReached) {
                        badgeHtml = '<span class="badge bg-secondary ms-2" style="font-size: 0.7rem;"><i class="fa-solid fa-ban"></i> Used up</span>';
                    } else if (notEnoughTotal) {
                        badgeHtml = `<span class="badge bg-warning text-dark ms-2" style="font-size: 0.7rem;"><i class="fa-solid fa-triangle-exclamation"></i> Min order: ${v.min_order.toLocaleString('vi-VN')}đ</span>`;
                    }

                    let disabledStyle = isDisabled ? 'opacity: 0.55; pointer-events: none; cursor: not-allowed;' : 'cursor: pointer;';
                    let bgClass = isDisabled ? 'bg-light' : '';
                    let radioDisabledAttr = isDisabled ? 'disabled' : '';

                    let discountDisplay = v.type === 'percent' ? (v.value * 100) + '% OFF' : v.value.toLocaleString('vi-VN') + 'đ OFF';

                        html += `
                        <label class="d-block w-100 mb-2" style="${disabledStyle}">
                            <input type="radio" name="voucher" class="voucher-radio d-none"
                                   value="${v.id}" onchange="selectTemp('${v.id}')" ${radioDisabledAttr}>
                            <div class="voucher-card-item border rounded p-2 d-flex justify-content-between align-items-center ${bgClass}">
                                <div class="voucher-info">
                                    <h6 class="mb-1 fw-bold" style="color: ${isDisabled ? '#6c757d' : '#0369a1'}">
                                        ${v.title}
                                        ${badgeHtml}
                                    </h6>
                                    <p class="mb-1 small text-muted">${v.desc}</p>
                                    <div class="expiry-date small text-secondary">
                                        <i class="fa-regular fa-clock me-1"></i>Exp: ${v.date}
                                    </div>
                                </div>
                                <div class="custom-radio-circle border rounded-circle ${isDisabled ? 'bg-secondary bg-opacity-25 border-secondary' : ''}" style="width: 20px; height: 20px;"></div>
                            </div>
                        </label>
                    `;
                });

                container.innerHTML = html;
            }

                function selectTemp(id) {
                tempSelectedVoucher = liveVouchers.find(v => v.id == id);
                    document.querySelectorAll('.voucher-card-item').forEach(el => el.classList.remove('border-primary', 'bg-light'));
                    const radio = document.querySelector(`input[value="${id}"]`);
                    if(radio) radio.nextElementSibling.classList.add('border-primary', 'bg-light');
                }

                function confirmVoucherSelection() {
                    if (tempSelectedVoucher) applyCodeLogic(tempSelectedVoucher);
                }

                    function applyManualCode() {
                    const inputEl = document.getElementById('manualInput');
                    if (!inputEl) return;
                    const code = inputEl.value.trim().toUpperCase();

                    if (!code) {
                        showErrorPopup("Please enter a promo code!");
                        return;
                    }

                    // Lấy tổng tiền 
                    const subTotal = parseFloat(document.getElementById('subTotalDisplay').getAttribute('data-price')) || 0;

                    // Gói dữ liệu thành POST Form 
                    const formData = new FormData();
                    formData.append('code', code);
                    formData.append('orderTotal', subTotal);

                    fetch('/Checkout/ApplyVoucher', {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => res.json())
                    .then(res => {
                        if (res.success) {
                            // trả về tiền giảm 
                            globalDiscount = res.discount;

                            document.getElementById('inputDiscount').value = globalDiscount;
                            document.getElementById('inputVoucherCode').value = code;

                            const selectorText = document.getElementById('voucherSelectorText');
                            const badge = document.getElementById('discountBadge');

                            if (selectorText) {
                                selectorText.innerText = code;
                                selectorText.classList.add('fw-bold', 'text-dark');
                            }
                            if (badge) {
                                badge.innerHTML = `<i class="fa-solid fa-wand-magic-sparkles"></i> -${globalDiscount.toLocaleString('vi-VN')} VND`;
                                badge.className = "badge bg-primary ms-2";
                                badge.classList.remove('d-none');
                            }

                            const discountRow = document.getElementById('discountRow');
                            if(discountRow) {
                                discountRow.classList.remove('d-none');
                                document.getElementById('discountDisplay').innerText = `-${globalDiscount.toLocaleString('vi-VN')} VND`;
                            }
                            recalculateTotal();

                            inputEl.value = '';
                            document.querySelectorAll('input[name="voucher"]').forEach(radio => radio.checked = false);
                            document.querySelectorAll('.voucher-card-item').forEach(el => el.classList.remove('border-primary', 'bg-light'));
                            tempSelectedVoucher = null;
                        } else {
                            showErrorPopup(res.message); 
                        }
                    })
                    .catch(err => {
                        console.error("Error:", err);
                        showErrorPopup("Network instability or API error. Please try again.");
                    });
                }

                function showErrorPopup(message) {
                    document.getElementById('voucherErrorMsg').innerText = message;
                    var myModal = new bootstrap.Modal(document.getElementById('voucherErrorModal'));
                    myModal.show();
                    const manualInput = document.getElementById('manualInput');
                    if (manualInput) {
                        manualInput.value = '';
                    }
                }

                function applyCodeLogic(voucher) {
                    const subTotal = parseFloat(document.getElementById('subTotalDisplay').getAttribute('data-price')) || 0;
                    if (subTotal < voucher.min_order) {
                        showErrorPopup(`Order does not meet requirements (Minimum ${voucher.min_order.toLocaleString('vi-VN')} VND)`);
                        return;
                    }

                    let discountAmount = (voucher.type === 'percent') ? (subTotal * voucher.value) : voucher.value;
                    if (voucher.type === 'percent' && discountAmount > voucher.max_reduce) discountAmount = voucher.max_reduce;

                    globalDiscount = discountAmount;
                    document.getElementById('inputDiscount').value = globalDiscount;
                    document.getElementById('inputVoucherCode').value = voucher.code;

                    const selectorText = document.getElementById('voucherSelectorText');
                    const badge = document.getElementById('discountBadge');

                    if (selectorText) {
                        selectorText.innerText = voucher.code;
                        selectorText.classList.add('fw-bold', 'text-dark');
                    }
                    if (badge) {
                        badge.innerHTML = `<i class="fa-solid fa-wand-magic-sparkles"></i> -${globalDiscount.toLocaleString('vi-VN')} VND`;
                        badge.className = "badge bg-primary ms-2";
                        badge.classList.remove('d-none');
                    }

                    const discountRow = document.getElementById('discountRow');
                    if(discountRow) {
                        discountRow.classList.remove('d-none');
                        document.getElementById('discountDisplay').innerText = `-${globalDiscount.toLocaleString('vi-VN')} VND`;
                    }
                    recalculateTotal();

                    const voucherModalEl = document.getElementById('voucherModal');
                    if (voucherModalEl && bootstrap.Modal.getInstance(voucherModalEl)) {
                         bootstrap.Modal.getInstance(voucherModalEl).hide();
                    }
                }

                function recalculateTotal() {
                    const subTotal = parseFloat(document.getElementById('subTotalDisplay').getAttribute('data-price')) || 0;
                    let final = subTotal + globalShippingFee - globalDiscount;
                    if (final < 0) final = 0;
                    document.getElementById('finalTotalDisplay').innerText = final.toLocaleString('vi-VN') + " VND";
                }

                function fillMainForm(data) {
                    if(document.getElementById('FullName')) document.getElementById('FullName').value = data.fullName;
                    if(document.getElementById('PhoneNumber')) document.getElementById('PhoneNumber').value = data.phoneNumber;
                    if(document.getElementById('Address')) document.getElementById('Address').value = data.address;

                    // Map chỉ nhảy khi thông tin được đổ ra trang checkout ngoài cùng
                    if (data.address && typeof movePinToAddress === 'function') {
                         movePinToAddress(data.address);
                    }
                }

                function loadAddressList() {
                    const container = document.getElementById('addressListContainer');
                    container.innerHTML = '<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Loading...</div>';

                    fetch('/Address/GetMyAddresses')
                        .then(res => res.json())
                        .then(res => {
                            container.innerHTML = '';
                            if (!res.data || res.data.length === 0) {
                                container.innerHTML = '<div class="text-center text-muted py-4"><i class="fa-regular fa-address-book fs-1 mb-2"></i><br>You haven\'t saved any addresses yet.</div>';
                                return;
                            }

                            res.data.forEach((addr) => {
                                const isChecked = addr.isDefault ? 'checked' : '';
                                const defaultBadge = addr.isDefault ? '<span class="badge bg-danger ms-2" style="font-size: 10px;">Default</span>' : '';
                                const borderClass = addr.isDefault ? 'border-primary bg-white' : 'border-light bg-white';

                                const html = `
                                    <label class="address-card w-100 cursor-pointer">
                                        <input type="radio" name="selectedAddress" value="${addr.id}"
                                            data-fullname="${addr.fullName}"
                                            data-phone="${addr.phoneNumber}"
                                            data-addr="${addr.address}"
                                            class="d-none peer" ${isChecked}
                                            onchange="highlightAddress(this)">

                                        <div class="card-body p-3 border rounded shadow-sm position-relative address-box ${borderClass}">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div>
                                                    <span class="fw-bold text-dark">${addr.fullName}</span>
                                                    <span class="text-muted border-start ps-2 ms-2 small">${addr.phoneNumber}</span>
                                                    ${defaultBadge}
                                                </div>
                                                <div class="custom-radio-circle border rounded-circle" style="width: 18px; height: 18px;"></div>
                                            </div>
                                            <div class="text-muted small text-start pe-4">${addr.address}</div>
                                        </div>
                                    </label>
                                `;
                                container.insertAdjacentHTML('beforeend', html);
                            });

                            const checkedRadio = container.querySelector('input:checked');
                            if(checkedRadio) highlightAddress(checkedRadio);
                        });
                }

                function highlightAddress(radio) {
                    document.querySelectorAll('.address-box').forEach(el => {
                        el.classList.remove('border-primary', 'bg-light');
                        el.querySelector('.custom-radio-circle').classList.remove('bg-primary', 'border-0');
                    });
                    const box = radio.nextElementSibling;
                    box.classList.add('border-primary', 'bg-light');
                    box.querySelector('.custom-radio-circle').classList.add('bg-primary', 'border-0');
                }

                function confirmSelectAddress() {
                    const selected = document.querySelector('input[name="selectedAddress"]:checked');
                    if (selected) {
                        const data = {
                            fullName: selected.dataset.fullname,
                            phoneNumber: selected.dataset.phone,
                            address: selected.dataset.addr
                        };
                        fillMainForm(data);
                        const modalEl = document.getElementById('addressListModal');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        modal.hide();
                    } else {
                        alert("Please select an address!");
                    }
                }

                    function saveNewAddress() {
                    const form = document.getElementById('newAddressForm');
                    if (!form.checkValidity()) {
                        form.reportValidity();
                        return;
                    }

                    const provSelect = document.getElementById('newProvince');
                    const distSelect = document.getElementById('newDistrict');
                    const wardSelect = document.getElementById('newWard');
                    const errorMsg = document.getElementById('addressErrorMsg');
                    const detailInput = document.getElementById('newAddressDetail').value;
                    const detailInputEl = document.getElementById('newAddressDetail');

                    errorMsg.classList.add('d-none');
                    detailInputEl.classList.remove('is-invalid');

                    //Kiểm tra điều kiện  
                    if (!provSelect.value || !distSelect.value || !wardSelect.value || !detailInput) {
                        errorMsg.classList.remove('d-none');
                        detailInputEl.classList.add('is-invalid');
                        return;
                    }

                    const provText = provSelect.options[provSelect.selectedIndex].text;
                    const distText = distSelect.options[distSelect.selectedIndex].text;
                    const wardText = wardSelect.options[wardSelect.selectedIndex].text;

                    const fullAddress = `${detailInput}, ${wardText}, ${distText}, ${provText}`;

                    const payload = {
                        FullName: document.getElementById('newFullName').value,
                        PhoneNumber: document.getElementById('newPhone').value,
                        Address: fullAddress,
                        IsDefault: document.getElementById('newIsDefault').checked
                    };


                    fetch('/Address/AddAddress', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(res => res.json())
                    .then(res => {
                        if (res.success) {
                            const addModal = bootstrap.Modal.getInstance(document.getElementById('addAddressModal'));
                            addModal.hide();
                            const listModal = new bootstrap.Modal(document.getElementById('addressListModal'));
                            listModal.show();

                            loadAddressList();

                            document.getElementById('newAddressForm').reset();
                            document.getElementById('newDistrict').innerHTML = '<option value="" selected disabled>Select District</option>';
                            document.getElementById('newDistrict').disabled = true;
                            document.getElementById('newWard').innerHTML = '<option value="" selected disabled>Select Ward</option>';
                            document.getElementById('newWard').disabled = true;
                        } else {
                            alert("Error: " + (res.msg ? res.msg : "An error occurred but the server did not provide a reason"));
                        }
                    });
                }

                function openAddNewAddressModal() {
                    const listModalEl = document.getElementById('addressListModal');
                    const listModal = bootstrap.Modal.getInstance(listModalEl);
                    if (listModal) {
                        listModal.hide();
                    }
                    setTimeout(() => {
                        const addModalEl = document.getElementById('addAddressModal');
                        const addModal = new bootstrap.Modal(addModalEl);
                        addModal.show();
                    }, 200);
                }

                function backToAddressList() {
                    const addModalEl = document.getElementById('addAddressModal');
                    const addModal = bootstrap.Modal.getInstance(addModalEl);
                    if (addModal) {
                        addModal.hide();
                    }
                    setTimeout(() => {
                        const listModalEl = document.getElementById('addressListModal');
                        const listModal = new bootstrap.Modal(listModalEl);
                        listModal.show();
                    }, 200);
                }

                document.getElementById('checkoutForm').addEventListener('submit', function (e) {
                    const name = document.getElementById('FullName').value.trim();
                    const phone = document.getElementById('PhoneNumber').value.trim();
                    const address = document.getElementById('Address').value.trim();

                    if (!name || !phone || !address) {
                        e.preventDefault();
                        alert("Please fill in your Full Name, Phone Number, and Shipping Address!");
                        return;
                    }

                    if (phone.length < 10 || phone.length > 11) {
                        e.preventDefault();
                        alert("Invalid Phone Number (must be 10-11 digits)!");
                        return;
                    }
                });
            </script>
    }

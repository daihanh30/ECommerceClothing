@model IEnumerable<ECommerceClothing.Models.Reviews>
@{
    ViewData["Title"] = "All Reviews - " + ViewBag.ProductName;
}

<div class="container my-5" style="max-width: 800px;">
    <a href="@Url.Action("Detail", "Product", new { id = ViewBag.ProductId })" class="text-dark text-decoration-none small fw-bold">
        <i class="bi bi-chevron-left"></i> BACK TO PRODUCT
    </a>

    <h2 class="fw-bold text-uppercase mt-4 mb-5" style="letter-spacing: 2px;">
        All Reviews for @ViewBag.ProductName
    </h2>

    <div class="review-list">
        @foreach (var r in Model)
        {
            <div class="review-item mb-5 pb-4 border-bottom">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; font-size: 12px; font-weight: bold;">
                            US
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 small text-uppercase">Verified Buyer</h6>
                            <div class="text-warning mt-1" style="font-size: 10px;">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fa-@(i <= r.Rating ? "solid" : "regular") fa-star"></i>
                                }
                            </div>
                        </div>
                    </div>
                    <span class="text-muted small">@r.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
                <p class="text-dark" style="font-size: 14px; line-height: 1.6;">@r.Comment</p>
                @if (!string.IsNullOrEmpty(r.ImageUrl))
                {
                    <img src="@r.ImageUrl" class="rounded border mt-2" style="width: 120px; height: 150px; object-fit: cover;">
                }
            </div>
        }
    </div>
</div>
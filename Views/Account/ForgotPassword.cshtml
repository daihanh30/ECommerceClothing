@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card p-4 shadow-sm" style="width: 100%; max-width: 400px; border-radius: 15px; background-color: #f3f3f3;">
        <h2 class="text-center fw-bold mb-4">Forgot Password?</h2>
        <p class="text-muted text-center">Enter your email to receive a 6-digit verification code.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-action="ForgotPassword" method="post">
            <div class="mb-3">
                <label class="form-label text-secondary">Email Address</label>
                <input type="email" name="email" class="form-control rounded-pill px-3" placeholder="email@gmail.com" required />
            </div>
            <button type="submit" class="btn btn-dark w-100 rounded-pill py-2 fw-bold">Send OTP</button>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Login" class="text-decoration-none text-dark small fw-bold">Back to Login</a>
        </div>
    </div>
</div>
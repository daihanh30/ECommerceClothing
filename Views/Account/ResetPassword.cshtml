@{
    ViewData["Title"] = "Reset Password";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card p-4 shadow-sm" style="width: 100%; max-width: 400px; border-radius: 15px; background-color: #f3f3f3;">
        <h2 class="text-center fw-bold mb-4">Set New Password</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-action="ResetPassword" method="post">
            <input type="hidden" name="email" value="@ViewBag.Email" />

            <div class="mb-3">
                <label class="form-label text-secondary">New Password</label>
                <input type="password" name="newPassword" class="form-control rounded-pill px-3" required />
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary">Confirm Password</label>
                <input type="password" name="confirmPassword" class="form-control rounded-pill px-3" required />
            </div>

            <button type="submit" class="btn btn-dark w-100 rounded-pill py-2 fw-bold">Update Password</button>
        </form>
    </div>
</div>
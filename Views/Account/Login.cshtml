@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-box">

        <div class="auth-left">
            <h2>Welcome Back!!</h2>

            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <p class="text-center fw-bold" style="color: #dc3545; font-size: 0.9rem; margin-top: -10px; margin-bottom: 20px;">
                    <i class="fa-solid fa-circle-exclamation me-1"></i> @ViewBag.Error
                </p>
            }

            <form asp-controller="Account" asp-action="Login" method="post">

                <div class="auth-group">
                    <label>Email</label>
                    <input type="email" name="email" placeholder="email@gmail.com" value="@ViewBag.Email" />
                </div>

                <div class="auth-group password-group">
                    <label>Password</label>
                    <input type="password" id="loginPass" name="password" placeholder="Enter password">

                    <span class="toggle-password" onclick="togglePassword('loginPass', this)">
                        <i class="fa-regular fa-eye-slash"></i>
                    </span>
                </div>

                <div class="auth-forgot">
                    <a asp-action="ForgotPassword" asp-controller="Account" class="text-decoration-none text-muted small">Forgot Password?</a>
                </div>

                <button type="submit" class="auth-btn">Login</button>
            </form>

            @{
                var success = Context.Request.Query["success"].ToString();
                var resetSuccess = Context.Request.Query["resetSuccess"].ToString();  
            }

            @if (success == "true")
            {
                <div class="success-overlay" id="successOverlay">
                    <div class="success-box">
                        <div class="success-icon">✓</div>

                        <p class="success-text">
                            Account registration successful
                        </p>

                        <button class="success-btn" onclick="closeSuccess()">
                            OK
                        </button>
                    </div>
                </div>
            }
            @if (resetSuccess == "true")
            {
                <div class="success-overlay" id="resetOverlay">
                    <div class="success-box">
                        <div class="success-icon">✓</div>

                        <p class="success-text">
                            Password changed successfully!<br />
                            Please login with your new password.
                        </p>

                        <button class="success-btn" onclick="closeResetSuccess()">
                            OK
                        </button>
                    </div>
                </div>
            }

            @section Scripts {
                <script>
                    function closeSuccess() { 
                        document.getElementById("successOverlay").style.display = "none";
                         
                        window.history.replaceState(null, "", "/Account/Login");
                    } 
                    function closeResetSuccess() {
                        document.getElementById("resetOverlay").style.display = "none";
                        window.history.replaceState(null, "", "/Account/Login");
                    }
                     
                    function togglePassword(id, el) {
                        const input = document.getElementById(id);
                        const icon = el.querySelector('i');
                        if (input.type === 'password') {
                            input.type = 'text';
                            icon.classList.replace('fa-eye-slash', 'fa-eye');
                        } else {
                            input.type = 'password';
                            icon.classList.replace('fa-eye', 'fa-eye-slash');
                        }
                    }
                </script>
            }

            <p class="auth-signup" style="margin-top: 20px;">
                Don’t have an account?
                <a asp-controller="Account" asp-action="Register">Sign up</a>
            </p>
        </div>

        <div class="auth-right d-none"></div>

    </div>
</div>
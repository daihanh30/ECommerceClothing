@model IEnumerable<ECommerceClothing.Models.Order>
@{
    ViewData["Title"] = "Order Management";
    Layout = "~/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Orders Management</h3>
        <div class="btn-group shadow-sm">
            <a asp-action="Index" asp-route-status="" class="btn btn-outline-dark @(string.IsNullOrEmpty(ViewBag.CurrentStatus) ? "active" : "")">All</a>
            <a asp-action="Index" asp-route-status="Pending" class="btn btn-outline-warning @(ViewBag.CurrentStatus == "Pending" ? "active" : "") text-dark">Pending</a>
            <a asp-action="Index" asp-route-status="Shipping" class="btn btn-outline-info @(ViewBag.CurrentStatus == "Shipping" ? "active" : "") text-dark">Shipping</a>
            <a asp-action="Index" asp-route-status="Delivered" class="btn btn-outline-success @(ViewBag.CurrentStatus == "Delivered" ? "active" : "")">Delivered</a>
            <a asp-action="Index" asp-route-status="Cancelled" class="btn btn-outline-danger @(ViewBag.CurrentStatus == "Cancelled" ? "active" : "")">Cancelled</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-uppercase small" style="letter-spacing: 0.5px;">
                            <th class="ps-4">Order ID</th>
                            <th>Customer</th>
                            <th>Order Date</th>
                            <th>Payment</th>
                            <th>Total</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@order.Id.ToString("D5")</td>
                                <td>
                                    <div class="fw-semibold">@order.FullName</div>
                                    <div class="small text-muted">@order.PhoneNumber</div>
                                </td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@order.PaymentMethod</td>
                                <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") VND</td>
                                <td class="text-center">
                                    <span class="badge @GetBadgeClass(order.Status) px-3 py-2 rounded-pill">@order.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-dark">
                                        Details / Process
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Shipping" => "bg-info text-dark",
            "Delivered" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
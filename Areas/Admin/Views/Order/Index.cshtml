@model IEnumerable<ECommerceClothing.Models.Order>
@{
    ViewData["Title"] = "Order Management";
    Layout = "~/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Manage Orders</h2>

        <div class="filter-tabs shadow-sm">
            <a asp-action="Index" asp-route-status=""
               class="filter-btn @(string.IsNullOrEmpty(ViewBag.CurrentStatus) ? "bg-dark text-white" : "")">All</a>

            <a asp-action="Index" asp-route-status="Pending"
               class="filter-btn @(ViewBag.CurrentStatus == "Pending" ? "status-pending" : "")">Pending</a>

            <a asp-action="Index" asp-route-status="Paid"
               class="filter-btn @(ViewBag.CurrentStatus == "Paid" ? "status-paid" : "")">Paid</a>

            <a asp-action="Index" asp-route-status="Shipping"
               class="filter-btn @(ViewBag.CurrentStatus == "Shipping" ? "status-shipping" : "")">Shipping</a>

            <a asp-action="Index" asp-route-status="Delivered"
               class="filter-btn @(ViewBag.CurrentStatus == "Delivered" ? "status-delivered" : "")">Delivered</a>

            <a asp-action="Index" asp-route-status="Cancelled"
               class="filter-btn @(ViewBag.CurrentStatus == "Cancelled" ? "status-cancelled" : "")">Cancelled</a>
        </div>
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-uppercase small text-muted" style="letter-spacing: 0.5px;">
                            <th class="ps-4 py-3 border-0">Order ID</th>
                            <th class="border-0">Customer</th>
                            <th class="border-0">Order Date</th>
                            <th class="border-0">Payment</th>
                            <th class="border-0">Total</th>
                            <th class="text-center border-0">Status</th>
                            <th class="text-end pe-4 border-0">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">#@order.Id.ToString("D5")</td>
                                <td>
                                    <div class="fw-semibold text-dark">@order.FullName</div>
                                    <div class="small text-muted">@order.PhoneNumber</div>
                                </td>
                                <td class="text-secondary">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-secondary">@order.PaymentMethod</td>

                                <td class="fw-bold text-dark">@order.TotalAmount.ToString("N0") VND</td>

                                <td class="text-center">
                                    <span class="status-badge @GetBadgeClass(order.Status)">@order.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-soft px-3">
                                        Details / Process
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "status-pending",
            "Paid" => "status-paid",
            "Shipping" => "status-shipping",
            "Delivered" => "status-delivered",
            "Cancelled" => "status-cancelled",
            "Unpaid" => "status-default",
            _ => "status-default"
        };
    }
}
@model ECommerceClothing.Models.Order
@{
    ViewData["Title"] = "Order Details #" + Model.Id;
    Layout = "~/Areas/Admin/Views/Admin/_AdminLayout.cshtml"; // Nhớ check lại đường dẫn Layout này nhé
}

<div class="container-fluid px-4 mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
                <i class="bi bi-arrow-left"></i> Back to list
            </a>
            <h3 class="fw-bold mb-0 text-uppercase">Order #@Model.Id.ToString("D5")</h3>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 mb-0 border-0 shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            </div>
        }
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white py-3">
                    <h6 class="mb-0 text-uppercase fw-bold">Shipping Information</h6>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Customer:</strong> @Model.FullName</p>
                    <p class="mb-2"><strong>Phone:</strong> @Model.PhoneNumber</p>
                    <p class="mb-2"><strong>Address:</strong> @Model.Address</p>
                    <p class="mb-2"><strong>Note:</strong> @(string.IsNullOrEmpty(Model.Note) ? "None" : Model.Note)</p>
                    <hr>
                    <p class="mb-2"><strong>Order Date:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-2"><strong>Payment Method:</strong> @Model.PaymentMethod</p>
                    <p class="mb-0 d-flex align-items-center">
                        <strong class="me-2">Current Status:</strong>
                        <span class="badge @GetBadgeClass(Model.Status) px-3 py-2 text-uppercase">@Model.Status</span>
                    </p>
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="fw-bold text-uppercase mb-3">Order Processing</h6>
                    <form asp-action="UpdateStatus" method="post" class="d-grid gap-2">
                        <input type="hidden" name="id" value="@Model.Id" />

                        @if (Model.Status == "Pending")
                        {
                            <button type="submit" name="newStatus" value="Shipping" class="btn btn-info text-dark fw-bold">
                                Confirm & Ship
                            </button>
                            <button type="submit" name="newStatus" value="Cancelled" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this order?');">
                                Cancel Order
                            </button>
                        }
                        else if (Model.Status == "Paid")
                        {
                            <button type="submit" name="newStatus" value="Shipping" class="btn btn-info text-dark fw-bold">
                                Confirm & Ship (Paid via MoMo)
                            </button>
                        }
                        else if (Model.Status == "Shipping")
                        {
                            <button type="submit" name="newStatus" value="Delivered" class="btn btn-success fw-bold">
                                Complete (Delivered)
                            </button>
                            <button type="submit" name="newStatus" value="Cancelled" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this shipping order?');">
                                Delivery Failed / Cancel
                            </button>
                        }
                        else if (Model.Status == "Delivered")
                        {
                            <div class="alert alert-success mb-0 text-center">Order has been completed</div>
                        }
                        else if (Model.Status == "Cancelled")
                        {
                            <div class="alert alert-danger mb-0 text-center">Order has been cancelled</div>
                        }
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 text-uppercase fw-bold">Ordered Products</h6>
                </div>
                <div class="card-body p-0">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">Product</th>
                                <th>Unit Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end pe-4">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center py-2">
                                            <img src="@(item.Product.Images?.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png")"
                                                 class="rounded border" style="width: 50px; height: 65px; object-fit: cover;">
                                            <div class="ms-3">
                                                <div class="fw-bold text-dark">@item.Product.Name</div>
                                                <div class="small text-muted">Size: @item.Size</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@((item.Price * 1000).ToString("N0")) VND</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end pe-4 fw-bold">@((item.Price * 1000 * item.Quantity).ToString("N0")) VND</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top py-3">
                    <div class="d-flex justify-content-end align-items-center">
                        <div class="text-end">
                            <div class="text-muted small mb-1">Shipping Fee: @Model.ShippingFee.ToString("N0") VND</div>
                            @if (Model.DiscountAmount > 0)
                            {
                                <div class="text-success small mb-1">Discount: -@Model.DiscountAmount.ToString("N0") VND</div>
                            }
                            <div class="fs-5 mt-2">
                                <span class="fw-bold me-2">TOTAL:</span>
                                <span class="fw-bold text-danger">@Model.TotalAmount.ToString("N0") VND</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Paid" => "bg-primary text-white",
            "Shipping" => "bg-info text-dark",
            "Delivered" => "bg-success text-white",
            "Cancelled" => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }
}
@model IEnumerable<ECommerceClothing.Models.AppUser>
@{
    ViewData["Title"] = "Customer Management";
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Manage Customers</h2>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Customers" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="search" class="form-control" placeholder="Search name, email, phone..." value="@ViewBag.CurrentSearch">
            </div>
            <div class="col-md-3">
                <select name="filter" class="form-select">
                    <option value="all" selected="@(ViewBag.CurrentFilter == "all")">All Customers</option>
                    <option value="new_this_month" selected="@(ViewBag.CurrentFilter == "new_this_month")">New This Month</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th class="text-end pe-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">
                            @* <img src="@user.AvatarUrl" class="rounded-circle me-2" width="30" height="30"> *@
                            @user.FullName
                        </td>
                        <td>@user.Email</td>
                        @* <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "--" : user.PhoneNumber)</td> *@
                        <td>--</td>
                        <td class="text-end pe-4">
                            @* Thêm cứng asp-area và asp-controller vào đây *@
                            <a asp-area="Admin" asp-controller="Admin" asp-action="CustomerDetails" asp-route-id="@user.Id" class="btn btn-sm btn-outline-dark">
                                <i class="fa-regular fa-eye"></i> View
                            </a>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
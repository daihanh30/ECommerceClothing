@model IEnumerable<ECommerceClothing.Models.AppUser>
@{
    ViewData["Title"] = "Customer Management";
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 mt-4 mb-5">

    <div class="mx-auto" style="max-width: 1100px;">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Manage Customers</h2>
        </div>

        <div class="search-filter-wrapper shadow-sm mb-4 border-0">
            <form method="get" asp-action="Customers" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 bg-light"
                               placeholder="Search name, email, phone..." value="@ViewBag.CurrentSearch"
                               style="box-shadow: none;">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-funnel"></i>
                        </span>
                        <select name="filter" class="form-select border-start-0 bg-light" style="box-shadow: none;">
                            <option value="all" selected="@(ViewBag.CurrentFilter == "all")">All Customers</option>
                            <option value="new_this_month" selected="@(ViewBag.CurrentFilter == "new_this_month")">New This Month</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn w-100 fw-bold" style="background-color: #10b981; color: white; border-radius: 8px;">
                        Filter
                    </button>
                </div>
            </form>
        </div>

        <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small text-uppercase">
                            <tr style="letter-spacing: 0.5px;">
                                <th class="ps-4 py-3 border-0">Full Name</th>
                                <th class="border-0">Email</th>
                                <th class="border-0">Phone</th>
                                <th class="text-end pe-4 border-0">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="fw-bold text-dark" style="font-size: 15px;">@user.FullName</div>
                                        </td>
                                        <td>
                                            <div class="text-dark">@user.Email</div>
                                        </td>
                                        <td>
                                            <div class="text-dark">@(string.IsNullOrEmpty(user.PhoneNumber) ? "--" : user.PhoneNumber)</div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-area="Admin" asp-controller="Admin" asp-action="CustomerDetails" asp-route-id="@user.Id"
                                               class="btn btn-sm btn-soft px-3">
                                                <i class="bi bi-eye me-1"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted fst-italic">
                                        <i class="bi bi-people fs-1 d-block mb-2"></i>
                                        No customers found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

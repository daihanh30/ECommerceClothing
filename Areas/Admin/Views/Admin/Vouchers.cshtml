@model IEnumerable<ECommerceClothing.Models.Voucher>
@{
    ViewData["Title"] = "Vouchers";
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Manage Vouchers</h2>
    <a asp-action="CreateVoucher" class="btn btn-custom-new px-3">
        <i class="bi bi-plus-lg"></i> New
    </a>
</div>

@{
    var currentType = Context.Request.Query["type"].ToString();
}

<ul class="nav nav-tabs border-0 mb-3" style="border-bottom: 1px solid #e2e8f0 !important;">
    <li class="nav-item">
        <a class="nav-link border-0 @(string.IsNullOrEmpty(currentType) ? "tab-custom-active" : "text-secondary fw-semibold")"
           asp-action="Vouchers">
            All Vouchers
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link border-0 @(currentType == "public" ? "tab-custom-active" : "text-secondary fw-semibold")"
           asp-action="Vouchers" asp-route-type="public">
            Public
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link border-0 @(currentType == "hidden" ? "tab-custom-active" : "text-secondary fw-semibold")"
           asp-action="Vouchers" asp-route-type="hidden">
            Hidden
        </a>
    </li>
</ul>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 18%;">Code</th>

                        <th style="width: 24%;">Title</th>

                        <th style="width: 14%;">Discount</th>
                        <th style="width: 11%;">Usage</th>
                        <th style="width: 11%;">Visibility</th>
                        <th style="width: 11%;">Status</th>
                        <th class="text-center pe-4" style="min-width: 200px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var visibilityClass = item.IsPublic ? "public" : "hidden";

                        <tr class="voucher-row" data-visibility="@visibilityClass">
                            <td class="ps-4 fw-bold text-dark">@item.Code</td>
                            <td class="text-secondary fw-medium">@item.Title</td>
                            <td>
                                @if (item.Type == "Percent")
                                {
                                    <span class="fw-bold" style="color: #0369a1; font-size: 1.05rem;">@((item.Value * 100).ToString("0"))%</span>
                                    <br>
                                }
                                else
                                {
                                    <span class="fw-bold" style="color: #0369a1; font-size: 1.05rem;">@item.Value.ToString("#,##0") VND</span>
                                    <br>
                                }
                                <small class="text-muted fw-medium">Min: @item.MinOrder.ToString("#,##0") VND</small>
                            </td>
                            <td>
                                @if (item.UsedCount >= item.Quantity)
                                {
                                    <span class="fw-bold text-danger">@item.UsedCount</span>
                                    <span class="text-muted fw-medium"> / @item.Quantity</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-success">@item.UsedCount</span>
                                    <span class="text-muted fw-medium"> / @item.Quantity</span>
                                }
                            </td>
                            <td>
                                @if (item.IsPublic)
                                {
                                    <span class="badge-soft badge-public">Public</span>
                                }
                                else
                                {
                                    <span class="badge-soft badge-hidden">Hidden</span>
                                }
                            </td>
                            <td>
                                @if (item.UsedCount >= item.Quantity)
                                {
                                    <span class="badge-soft badge-outofstock">Out of Stock</span>
                                }
                                else if (item.EndDate < DateTime.Now)
                                {
                                    <span class="badge-soft badge-expired">Expired</span>
                                }
                                else if (!item.IsActive)
                                {
                                    <span class="badge-soft badge-disabled">Disabled</span>
                                }
                                else
                                {
                                    <span class="badge-soft badge-active">Active</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex gap-2 justify-content-center flex-nowrap">
                                    <a asp-action="EditVoucher" asp-route-id="@item.Id" class="btn btn-custom-edit btn-sm px-3">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <button onclick="deleteVoucher(@item.Id, '@item.Code')" class="btn btn-custom-delete btn-sm px-3">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        @if (TempData["Success"] != null)
        {
                <text>
                document.addEventListener("DOMContentLoaded", function() {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: '@TempData["Success"]',
                        showConfirmButton: false,
                        timer: 3000
                    });
                });
                </text>
        }

        @if (TempData["Error"] != null)
        {
                <text>
                document.addEventListener("DOMContentLoaded", function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: '@TempData["Error"]',
                        showConfirmButton: false,
                        timer: 3000
                    });
                });
                </text>
        }

        // hàm xóa Voucher
        function deleteVoucher(id, code) {
            
            Swal.fire({
                title: 'Are you sure?',
                text: `Do you want to delete voucher "${code}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Chạy API xóa
                    fetch(`/Admin/DeleteVoucher/${id}`, {
                        method: 'POST'
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: data.message || 'Voucher deleted successfully!',
                                showConfirmButton: false,
                                timer: 3000
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Failed!',
                                text: data.message,
                                confirmButtonColor: '#000'
                            });
                        }
                    })
                    .catch(err => {
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: 'An error occurred while deleting!',
                            confirmButtonColor: '#000'
                        });
                    });
                }
            });
        }
    </script>
}
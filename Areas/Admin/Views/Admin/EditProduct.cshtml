@model ECommerceClothing.Models.Product
@{
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Product";
}

<style>
    .image-container {
        position: relative;
        display: inline-block;
        width: 100px;
        height: 100px;
        margin-right: 10px;
        margin-bottom: 10px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        overflow: hidden;
    }

        .image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .btn-delete-image {
        position: absolute;
        top: 0;
        right: 0;
        background-color: rgba(220, 53, 69, 0.8);
        color: white;
        border: none;
        width: 24px;
        height: 24px;
        text-align: center;
        line-height: 24px;
        font-weight: bold;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.2s ease-in-out;
        border-bottom-left-radius: 4px;
    }

    .image-container:hover .btn-delete-image {
        opacity: 1;
    }

    .btn-delete-image:hover {
        background-color: rgb(220, 53, 69);
    }
</style>

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Edit Product: @Model.Name</h5>
        </div>

        <div class="card-body bg-light">
            <form asp-area="Admin" asp-controller="Admin" asp-action="EditProduct" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <div id="deletedImagesContainer"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Product Name</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Category</label>
                        <select asp-for="CategoryId" class="form-select"
                                asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))"
                                id="CategorySelect">
                            <option value="">Select Category</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Product Type</label>
                        <select asp-for="ProductTypeId" class="form-select"
                                asp-items="@(new SelectList(ViewBag.ProductTypes, "ProductTypeId", "Name"))"
                                id="TypeSelect">
                            <option value="">Select Type</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Price</label>
                        <input asp-for="Price" type="number" class="form-control" />

                        @* Giữ lại hidden này để tránh lỗi Model *@
                        <input type="hidden" asp-for="Stock" />
                        <input type="hidden" asp-for="Size" id="SizeInput" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Phân loại Size & Số lượng tồn kho</label>
                        <div class="p-3 border rounded bg-white">
                            <div class="row">
                                @{
                                    string[] allSizes = { "S", "M", "L", "XL" };
                                    foreach (var sName in allSizes)
                                    {
                                        // Tìm xem sản phẩm hiện tại đã có size này trong kho chưa
                                        var existingSize = Model.ProductSizes?.FirstOrDefault(x => x.SizeName == sName);
                                        bool isChecked = existingSize != null;
                                        int qty = existingSize?.Quantity ?? 0;

                                        <div class="col-md-6 mb-3">
                                            <div class="size-item d-flex align-items-center">
                                                <div class="form-check me-2" style="width: 50px;">
                                                    <input class="form-check-input size-checkbox" type="checkbox"
                                                           value="@sName" id="size@sName" name="SelectedSizes"
                                                           @(isChecked ? "checked" : "")>
                                                    <label class="form-check-label fw-bold" for="size@sName">@sName</label>
                                                </div>
                                                <input type="number" name="SelectedQuantities"
                                                       class="form-control form-control-sm stock-input @(isChecked ? "" : "d-none")"
                                                       placeholder="Số lượng..." min="0"
                                                       value="@(isChecked? qty.ToString() : "")"
                                                       @(isChecked ? "" : "disabled")>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <small class="text-muted">Chỉnh sửa số lượng hoặc tick chọn size mới.</small>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Current Images (Hover to delete)</label>
                    <div class="d-flex gap-2 flex-wrap">
                        @if (Model.Images != null && Model.Images.Count > 0)
                        {
                            foreach (var img in Model.Images)
                            {
                                <div class="image-container" data-image-id="@img.Id">
                                    <img src="@img.ImageUrl" />
                                    <button type="button" class="btn-delete-image">×</button>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-success fw-bold">+ Add More Images</label>
                    <input type="file" name="images" multiple class="form-control" accept="image/*" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-area="Admin" asp-controller="Admin" asp-action="Products" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-dark">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // 1. Dropdown Category -> Type
        document.getElementById('CategorySelect').addEventListener('change', function() {
            var categoryId = this.value;
            var typeSelect = document.getElementById('TypeSelect');
            typeSelect.innerHTML = '<option value="">-- Select Type --</option>';
            if (categoryId) {
                fetch(`/Admin/Admin/GetProductTypesByCategory?categoryId=${categoryId}`)
                    .then(res => res.json())
                    .then(data => {
                        data.forEach(item => {
                            var opt = new Option(item.name, item.id);
                            typeSelect.add(opt);
                        });
                    });
            }
        });

        // 2. Xử lý Ẩn/Hiện ô nhập Stock theo Size
        const checkboxes = document.querySelectorAll('.size-checkbox');
        const hiddenSizeInput = document.getElementById('SizeInput');

        checkboxes.forEach(chk => {
            chk.addEventListener('change', function() {
                const qtyInput = this.closest('.size-item').querySelector('.stock-input');
                if (this.checked) {
                    qtyInput.classList.remove('d-none');
                    qtyInput.disabled = false;
                    qtyInput.required = true;
                } else {
                    qtyInput.classList.add('d-none');
                    qtyInput.disabled = true;
                    qtyInput.required = false;
                    qtyInput.value = '';
                }
                updateSizeString();
            });
        });

        function updateSizeString() {
            const checked = Array.from(checkboxes).filter(c => c.checked).map(c => c.value);
            hiddenSizeInput.value = checked.join(',');
        }

        // 3. Xử lý xóa ảnh cũ
        const deletedImagesContainer = document.getElementById('deletedImagesContainer');
        document.querySelectorAll('.btn-delete-image').forEach(btn => {
            btn.addEventListener('click', function() {
                const container = this.closest('.image-container');
                const imageId = container.getAttribute('data-image-id');
                container.remove();

                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'deletedImageIds';
                input.value = imageId;
                deletedImagesContainer.appendChild(input);
            });
        });
    });
</script>
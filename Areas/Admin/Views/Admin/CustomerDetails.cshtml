@model ECommerceClothing.ViewModels.CustomerDetail
@{
    ViewData["Title"] = "Customer Profile";
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 mt-4 mb-5">

    <div class="mb-4">
        <a asp-action="Customers" class="text-decoration-none text-muted fw-bold mb-2 d-inline-block" style="font-size: 14px; transition: color 0.2s;">
            <i class="bi bi-arrow-left me-1"></i> Back to Customers
        </a>
        <h3 class="fw-bold mb-0 text-uppercase" style="color: #2b3445;">Customer Profile</h3>
    </div>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm text-center p-4 h-100" style="border-radius: 12px;">

                <div class="avatar-wrapper">
                    <div class="avatar-lg shadow-sm">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                </div>

                <h5 class="fw-bold mb-1 text-dark" style="font-size: 18px;">@Model.FullName</h5>
                <p class="text-muted small mb-4">@Model.Email</p>

                <hr class="text-muted opacity-25 mx-3" />

                <div class="text-start px-3 mt-3">
                    <p class="mb-3 text-dark d-flex align-items-center">
                        <i class="bi bi-telephone text-muted me-3 fs-5"></i>
                        <span class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not updated" : Model.PhoneNumber)
                        </span>
                    </p>
                    <p class="mb-0 text-dark d-flex align-items-center">
                        <i class="bi bi-calendar-check text-muted me-3 fs-5"></i>
                        <span class="fw-semibold">Member since: 2026</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                        <p class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.5px;">Total Orders</p>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalOrders</h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px;">
                        <p class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.5px;">Total Spent</p>
                        <h3 class="fw-bold mb-0 text-dark">@(Model.TotalSpent.ToString("#,##0")) VND</h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px; @(Model.CancelRate > 30 ? "background-color: #fef2f2; border: 1px solid #fecaca !important;" : "")">
                        <p class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.5px;">Cancel Rate</p>

                        <div class="d-flex align-items-end gap-2">
                            <h3 class="fw-bold mb-0 @(Model.CancelRate > 30 ? "text-danger" : "text-dark")">
                                @Model.CancelRate%
                            </h3>

                            @if (Model.CancelRate > 30)
                            {
                                <span class="badge bg-danger rounded-pill mb-1"><i class="bi bi-exclamation-triangle-fill"></i> High Risk</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="fw-bold mb-0 text-uppercase text-muted" style="letter-spacing: 0.5px;">Order History</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase">
                                <tr style="letter-spacing: 0.5px;">
                                    <th class="ps-4 py-3 border-0">Order ID</th>
                                    <th class="border-0">Date</th>
                                    <th class="border-0">Total</th>
                                    <th class="text-center pe-4 border-0">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderHistory != null && Model.OrderHistory.Any())
                                {
                                    foreach (var order in Model.OrderHistory)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-dark">#@order.Id.ToString("D5")</td>
                                            <td class="text-secondary">@order.OrderDate.ToString("dd/MM/yyyy")</td>

                                            <td class="fw-bold text-dark">@(order.TotalAmount.ToString("#,##0")) VND</td>

                                            <td class="text-center pe-4">
                                                @if (order.Status.ToUpper() == "COMPLETED" || order.Status.ToUpper() == "DELIVERED")
                                                {
                                                    <span class="status-badge status-delivered">Delivered</span>
                                                }
                                                else if (order.Status.ToUpper() == "CANCELLED")
                                                {
                                                    <span class="status-badge status-cancelled">Cancelled</span>
                                                }
                                                else if (order.Status.ToUpper() == "SHIPPING")
                                                {
                                                    <span class="status-badge status-shipping">Shipping</span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge status-pending">Pending</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted fst-italic">
                                            <i class="bi bi-box fs-1 d-block mb-2"></i>
                                            This customer has not placed any orders yet.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
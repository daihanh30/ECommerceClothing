@model ECommerceClothing.ViewModels.CustomerDetail
@{
    ViewData["Title"] = "Customer Profile";
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
}

<div class="mb-4">
    <a asp-action="Customers" class="text-decoration-none text-muted"><i class="fa-solid fa-arrow-left"></i> Back to list</a>
    <h3 class="fw-bold mt-2">Customer Profile</h3>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="rounded-circle bg-dark text-white d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px; font-size: 24px;">
                @Model.FullName.Substring(0, 1).ToUpper()
            </div>
            <h5 class="fw-bold mb-1">@Model.FullName</h5>
            <p class="text-muted small mb-3">@Model.Email</p>
            <hr />
            <div class="text-start">
                <p class="mb-2"><i class="fa-solid fa-phone text-muted me-2"></i> @Model.PhoneNumber</p>
                <p class="mb-0"><i class="fa-regular fa-calendar text-muted me-2"></i> Member since: 2026</p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3">
                    <p class="text-muted small fw-bold text-uppercase mb-1">Total Orders</p>
                    <h3 class="fw-bold mb-0">@Model.TotalOrders</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3">
                    <p class="text-muted small fw-bold text-uppercase mb-1">Total Spent (CLV)</p>
                    <h3 class="fw-bold text-success mb-0">@(Model.TotalSpent.ToString("#,##0")) VND</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-3 border-start @(Model.CancelRate > 30 ? "border-danger border-4" : "")">
                    <p class="text-muted small fw-bold text-uppercase mb-1">Cancel Rate</p>
                    <h3 class="fw-bold @(Model.CancelRate > 30 ? "text-danger" : "text-dark") mb-0">
                        @Model.CancelRate%
                    </h3>
                    @if (Model.CancelRate > 30)
                    {
                        <small class="text-danger fw-bold">High Risk!</small>
                    }
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom p-3">
                <h6 class="fw-bold mb-0 text-uppercase">Order History</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Order ID</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderHistory != null && Model.OrderHistory.Any())
                        {
                            foreach (var order in Model.OrderHistory)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">#@order.Id</td>
                                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold">@(order.TotalAmount.ToString("#,##0")) VND</td>
                                    <td>
                                        @if (order.Status == "Completed" || order.Status == "Delivered")
                                        {
                                            <span class="badge bg-success">@order.Status</span>
                                        }
                                        else if (order.Status == "Cancelled")
                                        {

                                            <span class="badge bg-danger">@order.Status</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-warning text-dark">@order.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-4 text-muted">No orders found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
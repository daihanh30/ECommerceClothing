@model ECommerceClothing.Models.ShopSetting
@{
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Shop Settings";
}

<div class="row mt-2">
    <div class="col-lg-8 col-md-10 mx-auto">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0" style="color: #111827;">Manage Shop</h2>
        </div>
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="mb-0 fw-bold" style="color: #333;">Location & Display Info</h5>
                <small class="text-muted">Update the coordinates to change the map location on the checkout page.</small>
            </div>

            <div class="card-body bg-white p-4">
                <form asp-area="Admin" asp-controller="Admin" asp-action="UpdateShop" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted text-uppercase">Shop Name</label>
                            <input asp-for="ShopName" class="form-control bg-light" readonly />
                            <span asp-validation-for="ShopName" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted text-uppercase">Display Address</label>
                            <input asp-for="Address" class="form-control bg-light" readonly />
                            <span asp-validation-for="Address" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted text-uppercase">Latitude</label>
                            <input asp-for="Latitude" type="number" step="any" class="form-control" />
                            <span asp-validation-for="Latitude" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted text-uppercase">Longitude</label>
                            <input asp-for="Longitude" type="number" step="any" class="form-control" />
                            <span asp-validation-for="Longitude" class="text-danger small fw-bold mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-4" style="border-top: 1px solid #f1f5f9;">
                        <button type="reset" class="btn px-4 py-2 fw-bold" style="background-color: #f8fafc; color: #1e3a8a; border: 1px solid #e2e8f0; border-radius: 6px;">
                            Cancel
                        </button>
                        <button type="submit" class="btn px-4 py-2 fw-bold text-white" style="background-color: #10b981; border: none; border-radius: 6px;">
                            Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var successMsg = '@Html.Raw(TempData["SuccessMessage"])';
        if (successMsg) {
            Swal.fire({
                icon: 'success',
                title: 'Saved!',
                text: successMsg,
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true
            });
        }
    </script>
}
@model ECommerceClothing.Models.Dashboard
@{
    ViewData["Title"] = "Dashboard";
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
}

<div class="container-fluid p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold m-0">Dashboard Overview</h2>

            <div class="dropdown ms-auto">
                <button class="btn btn-dark btn-sm shadow-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fa-solid fa-file-export me-1"></i> Export Report
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                    <li><h6 class="dropdown-header fw-bold text-uppercase">Select Period</h6></li>
                    <li>
                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="ExportDashboardReport" asp-route-range="this_week">
                            <i class="fa-regular fa-calendar-week me-2 text-muted"></i> This Week
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="ExportDashboardReport" asp-route-range="this_month">
                            <i class="fa-regular fa-calendar-days me-2 text-muted"></i> This Month
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="ExportDashboardReport" asp-route-range="last_month">
                            <i class="fa-solid fa-clock-rotate-left me-2 text-muted"></i> Last Month
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item py-2 fw-bold" asp-controller="Admin" asp-action="ExportDashboardReport" asp-route-range="all">
                            <i class="fa-solid fa-download me-2"></i> Export All Time
                        </a>
                    </li>
                </ul>
            </div>
        </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100">
                <small class="text-uppercase fw-bold text-muted">Total Revenue</small>
                <h3 class="fw-bold mb-0 text-dark">@(Model.TotalRevenue.ToString("#,##0")) VND</h3>
                <i class="fa-solid fa-money-bill-trend-up position-absolute end-0 bottom-0 m-3 text-light fs-1"></i>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100">
                <small class="text-uppercase fw-bold text-muted">Total Orders</small>
                <h3 class="fw-bold mb-0 text-dark">@Model.TotalOrders</h3>
                <i class="fa-solid fa-cart-shopping position-absolute end-0 bottom-0 m-3 text-light fs-1"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100">
                <small class="text-uppercase fw-bold text-muted">Customers</small>
                <h3 class="fw-bold mb-0 text-dark">@Model.TotalCustomers</h3>
                <i class="fa-solid fa-users position-absolute end-0 bottom-0 m-3 text-light fs-1"></i>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white h-100">
                <small class="text-uppercase fw-bold text-muted">Products</small>
                <h3 class="fw-bold mb-0 text-dark">@Model.TotalProducts</h3>
                <i class="fa-solid fa-shirt position-absolute end-0 bottom-0 m-3 text-light fs-1"></i>
            </div>
        </div>
    </div>

    <div class="row mb-4 g-3">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4">
                <h6 class="fw-bold mb-4 text-uppercase text-muted">Revenue Analytics (Last 7 Days)</h6>
                <div style="height: 350px; position: relative;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h6 class="fw-bold mb-4 text-uppercase text-muted">Order Status</h6>
                <div style="height: 350px; position: relative;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-uppercase">Recent Orders</h6>
            <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="text-primary small text-decoration-none fw-bold">
                View All Orders <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3 border-0">Order ID</th>
                            <th class="border-0">Customer</th>
                            <th class="border-0 text-center">Total Amount</th>
                            <th class="border-0 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                        {
                            foreach (var o in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">#@o.Id.ToString("D5")</td>

                                    <td>
                                        <div class="fw-semibold text-dark">@o.FullName</div>
                                        <div class="small text-muted">@o.PhoneNumber</div>
                                    </td>

                                    <td class="fw-bold text-center text-dark">@(o.TotalAmount.ToString("#,##0")) VND</td>

                                    <td class="text-center">

                                        <span class="status-badge @GetBadgeClass(o.Status)">@o.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted fst-italic">No recent orders to display.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "status-pending",
            "Paid" => "status-paid",
            "Shipping" => "status-shipping",
            "Delivered" => "status-delivered",
            "Cancelled" => "status-cancelled",
            _ => "status-default"
        };
    }
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        console.log("DATA FLOWING DOWN FROM C#");
        console.log("Horizontal axis label (Date):", @Html.Raw(Json.Serialize(Model.ChartLabels)));
        console.log("Revenue data (Money):", @Html.Raw(Json.Serialize(Model.ChartData)));
        console.log("Pie chart data (Quantity):", @Html.Raw(Json.Serialize(Model.OrderStatusCounts)));

        //Line Chart
        const ctxRevenue = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctxRevenue, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ChartLabels)),
                datasets: [{
                    label: 'Revenue',
                    data: @Html.Raw(Json.Serialize(Model.ChartData)),
                    borderColor: '#00b074',
                    backgroundColor: 'rgba(0, 176, 116, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#0d6efd'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let value = context.parsed.y;
                                return ' Revenue: ' + new Intl.NumberFormat('en-US').format(value) + ' VND';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { borderDash: [5, 5] },
                        ticks: {
                            callback: function(value) {
                                if (value >= 1000000) {
                                    return (value / 1000000) + 'M'; 
                                }
                                if (value >= 1000) {
                                    return (value / 1000) + 'k'; 
                                }
                                return value;
                            }
                        }
                    },
                    x: { grid: { display: false } }
                }
            }
        });

        //biểu đồ tròn
        const ctxCategory = document.getElementById('categoryChart').getContext('2d');
        new Chart(ctxCategory, {
            type: 'doughnut',
            data: {
                labels: ['Delivered', 'Cancelled'],
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.OrderStatusCounts)),
                    backgroundColor: [
                        '#10b981', 
                        '#f59e0b'  
                    ],
                    borderWidth: 2,
                    borderColor: '#fff',
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true,
                        }
                    }
                },
                cutout: '65%'
            }
        });
    </script>
}
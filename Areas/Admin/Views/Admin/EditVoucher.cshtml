@model ECommerceClothing.Models.Voucher
@{
    ViewData["Title"] = "Edit Voucher";
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color: #1e293b;">Edit Voucher: <span style="color: #10b981;">@Model.Code</span></h2>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body bg-white p-4">
        <form asp-action="EditVoucher" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UsedCount" />

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label asp-for="Code" class="form-label">Promo Code <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control text-uppercase" required />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">Title</label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <label asp-for="Type" class="form-label">Discount Type</label>
                    <select asp-for="Type" class="form-select">
                        <option value="Percent">Percentage (%)</option>
                        <option value="Fixed">Fixed Amount (₫)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Value" class="form-label">Value</label>
                    <input asp-for="Value" type="number" step="0.01" class="form-control" required />
                    <span asp-validation-for="Value" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaxReduce" class="form-label">Max Discount (₫)</label>
                    <input type="text" class="form-control" value="@(Model?.MaxReduce.ToString("#,##0"))" oninput="formatMoney(this, 'MaxReduce')" required />
                    <input type="hidden" asp-for="MaxReduce" />
                    <span asp-validation-for="MaxReduce" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <label asp-for="MinOrder" class="form-label">Min Order Value (₫)</label>
                    <input type="text" class="form-control" value="@(Model?.MinOrder.ToString("#,##0"))" oninput="formatMoney(this, 'MinOrder')" required />
                    <input type="hidden" asp-for="MinOrder" />
                    <span asp-validation-for="MinOrder" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Quantity" class="form-label">Total Quantity</label>
                    <input asp-for="Quantity" type="number" class="form-control" required />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="UsageLimitPerUser" class="form-label">Usage Limit Per User</label>
                    <input asp-for="UsageLimitPerUser" type="number" class="form-control" required />
                    <span asp-validation-for="UsageLimitPerUser" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" type="datetime-local" class="form-control" required />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input asp-for="EndDate" type="datetime-local" class="form-control" required />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <div class="switch-box d-flex align-items-center">
                        <div class="form-check form-switch mb-0">
                            <input asp-for="IsPublic" class="form-check-input" type="checkbox" id="switchPublicEdit">
                            <label class="form-check-label fw-bold ms-2 text-dark" for="switchPublicEdit">
                                Public Voucher <br>
                                <small class="text-muted fw-normal">Show in Checkout list (Uncheck for Hidden code)</small>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="switch-box d-flex align-items-center">
                        <div class="form-check form-switch mb-0">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="switchActiveEdit">
                            <label class="form-check-label fw-bold ms-2 text-dark" for="switchActiveEdit">
                                Status: Active <br>
                                <small class="text-muted fw-normal">Allow users to apply this code</small>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 pt-3" style="border-top: 1px solid #e2e8f0;">
                <a asp-action="Vouchers" class="btn btn-custom-cancel">Cancel</a>
                <button type="submit" class="btn btn-custom-new">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        function formatMoney(inputDisplay, hiddenInputId) { 
            let rawValue = inputDisplay.value.replace(/[^0-9]/g, ''); 
            document.getElementById(hiddenInputId).value = rawValue; 
            inputDisplay.value = rawValue ? parseInt(rawValue, 10).toLocaleString('en-US') : '';
        }
    </script>
}

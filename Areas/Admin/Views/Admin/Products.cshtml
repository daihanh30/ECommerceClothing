@model IEnumerable<ECommerceClothing.Models.Product>
@{
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Products";
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Manage Products</h2>

    <div class="d-flex align-items-stretch gap-2">

        <div class="border rounded px-3 d-flex align-items-center text-dark text-nowrap" style="background-color: #f8f9fa;">
            Products: @ViewBag.TotalProducts <span class="mx-2 text-secondary">|</span> Out of Stock: <span class="text-danger ms-1">@ViewBag.OutOfStock</span>
        </div>

        <form method="get" class="m-0 d-flex">
            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var c in ViewBag.Categories)
                    {
                        <option value="@c.Id" selected="@(Context.Request.Query["categoryId"] == c.Id.ToString())">
                            @c.Name
                        </option>
                    }
                }
            </select>
        </form>

        <a asp-area="Admin" asp-controller="Admin" asp-action="CreateProduct" class="btn btn-custom-new d-flex align-items-center">
            <i class="bi bi-plus-lg me-1"></i> New
        </a>

    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:80px" class="text-center">Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Created</th>
                    <th style="width:220px" class="text-center">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in Model)
                {
                    var img = p.Images?.FirstOrDefault()?.ImageUrl;

                    <tr>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(img))
                            {
                                <img src="@img" class="rounded border" style="width:60px;height:60px;object-fit:cover;">
                            }
                            else
                            {
                                <span class="text-muted small">No Img</span>
                            }
                        </td>

                        <td class="fw-semibold">@p.Name</td>

                        <td>
                            <span class="badge-custom-category">
                                @p.ProductTypeObj?.Category?.Name
                            </span>
                        </td>

                        <td class="fw-bold text-price-black">@((p.Price * 1000).ToString("N0")) VND</td>

                        <td>
                            <div class="small">
                                @if (p.ProductSizes != null && p.ProductSizes.Any())
                                {
                                    var totalStock = p.ProductSizes.Sum(x => x.Quantity);

                                    var sortedSizes = p.ProductSizes.OrderBy(x =>
                                    x.SizeName.ToUpper() == "S" ? 1 :
                                    x.SizeName.ToUpper() == "M" ? 2 :
                                    x.SizeName.ToUpper() == "L" ? 3 :
                                    x.SizeName.ToUpper() == "XL" ? 4 : 5
                                    );

                                    foreach (var s in sortedSizes)
                                    {
                                        <div class="d-flex justify-content-between border-bottom pb-1 mb-1" style="min-width: 90px; border-color: #f1f5f9 !important;">
                                            <span class="fw-bold text-secondary">@s.SizeName:</span>

                                            <span class="@(s.Quantity <= 0 ? "text-danger fw-bold" : s.Quantity <= 5 ? "text-warning fw-bold" : "text-dark fw-bold")">
                                                @s.Quantity
                                            </span>
                                        </div>
                                    }

                                    if (totalStock <= 0)
                                    {
                                        <div class="text-danger fw-bold text-end mt-2">Out of stock</div>
                                    }
                                    else
                                    {
                                        <div class="mt-2 fw-bold text-stock-total text-end" style="border-top: 1px dashed #e2e8f0; padding-top: 4px;">
                                            Total: @totalStock
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-danger fw-bold mt-1">Out of stock</div>
                                }
                            </div>
                        </td>
                        <td>@p.CreatedAt.ToString("dd/MM/yyyy")</td>

                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-area="Admin" asp-controller="Admin" asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-custom-edit btn-sm px-3">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>

                                <button type="button" class="btn btn-custom-delete btn-sm px-3" onclick="deleteProductConfirm('@p.Id')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
     
        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: '@TempData["SuccessMessage"]',
                    showConfirmButton: false,
                    timer: 2000,             
                    timerProgressBar: true    
                });
                </text>
        }
    </script>
    <script>
        function openEditProductModal(id, name) {
            document.getElementById('editProductId').value = id;
            document.getElementById('editProductName').value = name;

            var myModal = new bootstrap.Modal(document.getElementById('editProductModal'));
            myModal.show();
        }
    </script>

    <script>  
        var successMsg = '@Html.Raw(TempData["SuccessMessage"])';

        if (successMsg) {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: successMsg,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'OK'
            });
        }

        function deleteProductConfirm(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to delete this product?", 
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d', 
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) { 
                    window.location.href = '/Admin/Admin/Delete/' + id;
                }
            })
        }
    </script>
}
@model IEnumerable<ECommerceClothing.Models.Product>
@{
    Layout = "/Areas/Admin/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Products";
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Products Management</h2>

    <div class="d-flex gap-2">
        @* Nút New: Đã sửa để khớp với ID createProductModal ở dưới *@
        <a asp-area="Admin" asp-controller="Admin" asp-action="CreateProduct" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> New
        </a>

        <form method="get">
            <select name="categoryId"
                    class="form-select"
                    onchange="this.form.submit()">
                <option value="">All Categories</option>

                @if (ViewBag.Categories != null)
                {
                    foreach (var c in ViewBag.Categories)
                    {
                        <option value="@c.Id"
                                selected="@(Context.Request.Query["categoryId"] == c.Id.ToString())">
                            @c.Name
                        </option>
                    }
                }
            </select>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:80px" class="text-center">Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Created</th>
                    <th style="width:220px" class="text-center">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in Model)
                {
                    var img = p.Images?.FirstOrDefault()?.ImageUrl;

                    <tr>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(img))
                            {
                                <img src="@img" class="rounded border" style="width:60px;height:60px;object-fit:cover;">
                            }
                            else
                            {
                                <span class="text-muted small">No Img</span>
                            }
                        </td>

                        <td class="fw-semibold">@p.Name</td>

                        <td>
                            <span class="badge bg-secondary">
                                @p.Category?.Name
                            </span>
                        </td>

                        @* 👉 ĐÃ FIX: Nhân 1000 và đổi sang VND *@
                        <td class="fw-bold text-primary">@((p.Price * 1000).ToString("N0")) VND</td>

                        <td>
                            <div class="small">
                                @if (p.ProductSizes != null && p.ProductSizes.Any())
                                {
                                    // Duyệt qua từng Size để in ra số lượng
                                    foreach (var s in p.ProductSizes.OrderBy(x => x.SizeName))
                                    {
                                        <div class="d-flex justify-content-between border-bottom pb-1 mb-1" style="min-width: 90px;">
                                            <span class="fw-bold text-secondary">@s.SizeName:</span>
                                            @* Nếu sắp hết hàng (dưới 5 cái) thì hiện màu đỏ cảnh báo *@
                                            <span class="@(s.Quantity <= 5 ? "text-danger fw-bold" : "text-dark")">
                                                @s.Quantity
                                            </span>
                                        </div>
                                    }
                                    // In ra tổng kho bên dưới cho dễ nhìn
                                    <div class="mt-1 fw-bold text-primary text-end">
                                        Total: @p.Stock
                                    </div>
                                }
                                else
                                {
                                    @* Trường hợp chưa nhập kho cho từng size *@
                                    <span class="text-muted italic">No size data</span>
                                    <div class="fw-bold">Total: @p.Stock</div>
                                }
                            </div>
                        </td>
                        <td>@p.CreatedAt.ToString("dd/MM/yyyy")</td>

                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-area="Admin" asp-controller="Admin" asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-success btn-sm px-3">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>

                                <button type="button" class="btn btn-danger btn-sm px-3" onclick="deleteProductConfirm('@p.Id')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ================= ĐOẠN THÊM MỚI: CÁC MODAL VÀ SCRIPT ================= *@

<div class="modal fade" id="createProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form asp-area="Admin" asp-controller="Admin" asp-action="CreateProduct" method="post" enctype="multipart/form-data">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Product Name</label>
                            <input type="text" name="Name" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <select name="CategoryId" class="form-select" required>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var c in ViewBag.Categories)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Price</label>
                            <input type="number" name="Price" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Stock</label>
                            <input type="number" name="Stock" class="form-control" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Product Images (Multiple)</label>
                            <input type="file" name="images" class="form-control" multiple>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-success">Save Product</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-area="Admin" asp-controller="Admin" asp-action="EditProduct" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Quick Edit Name</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="editProductId" />
                    <div class="mb-3">
                        <label class="form-label">Product Name</label>
                        <input type="text" name="Name" id="editProductName" class="form-control" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Update</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditProductModal(id, name) {
            document.getElementById('editProductId').value = id;
            document.getElementById('editProductName').value = name;

            var myModal = new bootstrap.Modal(document.getElementById('editProductModal'));
            myModal.show();
        }
    </script>

    <script>
        // --- 1. HIỆN POPUP THÔNG BÁO THÀNH CÔNG ---
        // (Cái này sẽ hiện lên sau khi xóa xong và trang load lại)
        var successMsg = '@Html.Raw(TempData["SuccessMessage"])';

        if (successMsg) {
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: successMsg,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'OK'
            });
        }

        // --- 2. HÀM HỎI CHẮC CHẮN (KHI BẤM NÚT DELETE) ---
        function deleteProductConfirm(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to delete this product?", // Câu hỏi tiếng Anh
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33', // Nút xóa màu đỏ
                cancelButtonColor: '#6c757d', // Nút hủy màu xám
                confirmButtonText: 'Yes',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Nếu User bấm Yes -> Chuyển hướng đến Action DeleteProduct trong AdminController
                    // Đường dẫn: /Area/Controller/Action/Id
                    window.location.href = '/Admin/Admin/Delete/' + id;
                }
            })
        }
    </script>
}
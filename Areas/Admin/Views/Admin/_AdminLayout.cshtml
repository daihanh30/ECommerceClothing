<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <link href="~/css/admin.css" rel="stylesheet">
</head>
<body>

    <div class="d-flex">

        <div class="admin-sidebar">

            <div class="sidebar-profile">
                <div class="profile-info">
                    <strong>Admin Panel</strong>
                </div>
            </div>

            <div class="sidebar-section">GENERAL</div>
            <ul class="sidebar-menu list-unstyled">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 me-2"></i> Dashboard
                    </a>
                </li>
            </ul>

            <div class="sidebar-section">MANAGEMENT</div>
            <ul class="sidebar-menu list-unstyled">

                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Categories">
                        <i class="bi bi-tags me-2"></i> Category
                    </a>
                </li>

                <li class="nav-item">
                    @* Lưu ý: Ní nhớ tạo Action "ProductTypes" trong AdminController hoặc trỏ thẳng vào ProductTypesController *@
                    <a class="nav-link" asp-area="Admin" asp-controller="ProductTypes" asp-action="Index">
                        <i class="bi bi-layers me-2"></i> Product Types
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Products">
                        <i class="bi bi-box-seam me-2"></i> Products
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Vouchers">
                        <i class="bi bi-ticket-detailed me-2"></i> Vouchers
                    </a>
                </li>

                <li>
                    <a class="nav-link" asp-area="Admin" asp-controller="Order" asp-action="Index">
                        <i class="bi bi-receipt"></i> Orders
                    </a>
                </li>

                <li>
                    <a class="nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Customers">
                        <i class="bi bi-people"></i> Customers
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer mt-auto">
                <div class="sidebar-footer mt-auto">
                    <a class="nav-link text-danger" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door me-2"></i> Back to Homepage
                    </a>
                </div>
            </div>
        </div>

        <div class="admin-content flex-grow-1 p-4">
            @RenderBody()
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@TempData["SuccessMessage"]',

            // --- ĐÂY LÀ 2 DÒNG QUYẾT ĐỊNH YÊU CẦU CỦA NÍ ---
            showConfirmButton: false, 
            timer: 2000       
            // ----------------------------------------------
        });
    </script>
}